---
const {
  title = 'Fabuela Cafe & Brunch | فابوێلا کافێ',
  description = 'The first brunch cafe in Iraq. Specialty coffee, Slow hours, and thoughtful plates in Erbil, Sulaymaniyah and Baghdad.',
} = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070707" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content="Astro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat:wght@500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --ink: #070707;
        --cream: #F1F1EF;
        --amber: #D58C3D;
      }
      * { -webkit-font-smoothing: antialiased; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--ink);
        color: #ffffff;
        font-family: 'Inter', system-ui, sans-serif;
        overflow-x: hidden;
        margin: 0;
      }
      body.no-scroll { overflow: hidden; }
      ::selection { background: var(--amber); color: var(--ink); }

      /* Typography utilities */
      .display { font-family: 'Anton', sans-serif; font-weight: 400; letter-spacing: -0.03em; line-height: 0.95; }
      .script { font-family: 'Caveat', cursive; }
      .mono { font-family: 'JetBrains Mono', monospace; }

      /* Reveal animation */
      .reveal { opacity: 0; transform: translateY(28px); transition: opacity 800ms cubic-bezier(.16,1,.3,1), transform 900ms cubic-bezier(.16,1,.3,1); }
      .reveal.in { opacity: 1; transform: translateY(0); }

      .line-mask { display: block; overflow: hidden; }
      .line-mask > span { display: block; transform: translateY(115%); transition: transform 900ms cubic-bezier(.16,1,.3,1); }
      .line-mask.in > span { transform: translateY(0); }

      .wipe-mask { display: inline-block; overflow: hidden; vertical-align: bottom; }
      .wipe-mask > span { display: inline-block; transform: translateX(-102%); transition: transform 900ms cubic-bezier(.16,1,.3,1); }
      .wipe-mask.in > span { transform: translateX(0); }

      /* Underline on hover */
      .ulink { position: relative; }
      .ulink::after {
        content: ''; position: absolute; left: 0; bottom: -3px; height: 1px; width: 100%;
        background: currentColor; transform: scaleX(0); transform-origin: left;
        transition: transform .5s cubic-bezier(.16,1,.3,1);
      }
      .ulink:hover::after { transform: scaleX(1); }

      /* Marquee */
      @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      .marquee-track { animation: marquee 40s linear infinite; }

      /* 3D tilt utilities */
      .tilt { transform-style: preserve-3d; transition: transform .5s cubic-bezier(.16,1,.3,1); will-change: transform; }
      .tilt-inner { transform: translateZ(30px); }

      /* Scrollbar */
      ::-webkit-scrollbar { width: 10px; }
      ::-webkit-scrollbar-track { background: #070707; }
      ::-webkit-scrollbar-thumb { background: #1f1f1d; border-radius: 6px; }
      ::-webkit-scrollbar-thumb:hover { background: #2a2a27; }

      /* Gradient scrims */
      .hero-scrim {
        background: linear-gradient(90deg, rgba(7,7,7,.92) 0%, rgba(7,7,7,.75) 35%, rgba(7,7,7,0) 65%);
      }
      .philosophy-scrim {
        background: linear-gradient(180deg, rgba(7,7,7,.85) 0%, rgba(7,7,7,0) 35%, rgba(7,7,7,0) 65%, rgba(7,7,7,.85) 100%);
      }

      /* Dot pulse */
      .dot-pulse { position: relative; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--amber); }
      .dot-pulse::after {
        content: ''; position: absolute; inset: -4px; border-radius: 50%;
        background: var(--amber); opacity: .35; animation: dotPulse 1.8s ease-out infinite;
      }
      @keyframes dotPulse {
        0% { transform: scale(0.9); opacity: .55; }
        100% { transform: scale(2.3); opacity: 0; }
      }

      /* Noise overlay */
      .noise::before {
        content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0.035;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        mix-blend-mode: overlay;
      }
    </style>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Reveal on scroll
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); revealObserver.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
      document.querySelectorAll('.reveal, .line-mask, .wipe-mask').forEach((el) => revealObserver.observe(el));

      // 3D tilt on hover
      document.querySelectorAll('[data-tilt]').forEach((el) => {
        const strength = parseFloat(el.getAttribute('data-tilt')) || 8;
        el.addEventListener('mousemove', (ev) => {
          const r = el.getBoundingClientRect();
          const x = (ev.clientX - r.left) / r.width - 0.5;
          const y = (ev.clientY - r.top) / r.height - 0.5;
          el.style.transform = `perspective(1000px) rotateY(${x * strength}deg) rotateX(${-y * strength}deg) translateZ(0)`;
        });
        el.addEventListener('mouseleave', () => {
          el.style.transform = 'perspective(1000px) rotateY(0deg) rotateX(0deg)';
        });
      });
    </script>
  </body>
</html>