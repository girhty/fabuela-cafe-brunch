---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Fabuela Cafe & Brunch | فابوێلا کافێ',
  description = "The first brunch café in Iraq. Specialty coffee, thoughtfully plated brunch, and unforgettable moments across Erbil, Sulaymaniyah, and Baghdad.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#070707" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://scontent-ams2-1.cdninstagram.com/v/t51.2885-19/472606846_572910068875664_7740883200850795873_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=107&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=oUoAHu51TioQ7kNvwE_feMr&_nc_oc=Adq4aPQEM9FObWWLGxLoyTM4aMjVNqpI8Jq0NQgt8N_uSxViqbox1ICaMhOkout_8gc&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_ss=79a8c&oh=00_AQIZSP7YAS0dllML3QF8VTMgz8kLGMQqyWIGxpeCO_6L7Q&oe=6ABF3B6B" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Caveat:wght@500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <style is:global>
      :root {
        --roast: #070707;
        --surface: #171715;
        --crema: #D58C3D;
        --bone: #F1F1EF;
        --bone2: #E7E5E3;
      }

      html, body { background: var(--roast); color: #fff; }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      ::selection { background: var(--crema); color: #070707; }

      /* Custom scrollbar */
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: #0a0a0a; }
      ::-webkit-scrollbar-thumb { background: #2c1a11; border-radius: 0; }
      ::-webkit-scrollbar-thumb:hover { background: var(--crema); }

      /* Ambient liquid gradient */
      .ambient-liquid {
        position: absolute;
        inset: 0;
        z-index: 0;
        background:
          radial-gradient(50% 60% at 15% 20%, rgba(110, 62, 34, 0.55) 0%, transparent 60%),
          radial-gradient(45% 55% at 85% 30%, rgba(213, 140, 61, 0.28) 0%, transparent 55%),
          radial-gradient(60% 70% at 50% 100%, rgba(44, 26, 17, 0.9) 0%, transparent 70%),
          radial-gradient(40% 50% at 90% 90%, rgba(198, 155, 110, 0.18) 0%, transparent 55%),
          linear-gradient(180deg, #070707 0%, #0b0806 45%, #110B07 100%);
        filter: saturate(1.05) blur(0.5px);
        animation: ambientDrift 22s ease-in-out infinite alternate;
      }

      @keyframes ambientDrift {
        0%   { background-position: 0% 0%, 100% 0%, 50% 100%, 100% 100%, 0 0; }
        100% { background-position: 10% 6%, 92% 8%, 48% 96%, 88% 92%, 0 0; }
      }

      /* Grain texture */
      .grain::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        opacity: 0.07;
        mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.9'/></svg>");
      }

      /* Header dynamic theme inversion */
      #site-header {
        color: #ffffff;
        transition: color .35s ease;
      }
      #site-header .nav-link,
      #site-header .nav-cta,
      #site-header .brand-word,
      #site-header .brand-sub,
      #site-header .hamb span { color: inherit; }
      #site-header .hamb span { background: currentColor; }
      #site-header .brand-word { color: inherit; }
      #site-header .brand-sub { color: inherit; opacity: .55; }

      #site-header[data-current-theme="light"] { color: #070707; }

      /* Reveal from clip mask */
      .reveal-mask {
        display: block;
        overflow: hidden;
      }
      .reveal-mask > * {
        display: block;
        transform: translateY(115%);
        transition: transform 1.05s cubic-bezier(.19, 1, .22, 1);
        will-change: transform;
      }
      .reveal-mask.is-in > * { transform: translateY(0); }

      /* Horizontal script wipe */
      .script-wipe {
        display: inline-block;
        clip-path: inset(0 100% 0 0);
        transition: clip-path 1.1s cubic-bezier(.19, 1, .22, 1);
      }
      .script-wipe.is-in { clip-path: inset(0 0 0 0); }

      /* Fade-up */
      .fade-up {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity .9s cubic-bezier(.19,1,.22,1), transform .9s cubic-bezier(.19,1,.22,1);
      }
      .fade-up.is-in { opacity: 1; transform: none; }

      /* 3D tilt base */
      [data-tilt] {
        transform-style: preserve-3d;
        transition: transform .5s cubic-bezier(.19,1,.22,1);
        will-change: transform;
      }

      /* Preloader cup */
      .cup {
        position: relative;
        width: 44px;
        height: 60px;
        border: 1.5px solid rgba(255,255,255,0.75);
        border-radius: 4px 4px 14px 14px;
        overflow: hidden;
        background: transparent;
      }
      .cup::before {
        content: "";
        position: absolute;
        top: -8px;
        left: -1.5px;
        right: -1.5px;
        height: 8px;
        background: #070707;
        border-bottom: 1.5px solid rgba(255,255,255,0.75);
      }
      .cup-fill {
        position: absolute;
        inset: auto 0 0 0;
        height: 0%;
        background: linear-gradient(180deg, #C69B6E 0%, #B07A45 45%, #6E3E22 100%);
        transition: height .35s ease;
      }

      /* Receipt zig-zag */
      .receipt-zigzag {
        height: 14px;
        background:
          linear-gradient(135deg, transparent 50%, #f4f0e8 50%) 0 0/14px 14px repeat-x,
          linear-gradient(-135deg, transparent 50%, #f4f0e8 50%) 7px 0/14px 14px repeat-x;
        background-color: transparent;
      }

      .receipt-shadow { box-shadow: 0 30px 60px -20px rgba(0,0,0,0.8), 0 10px 30px -10px rgba(0,0,0,0.6); }

      /* Underline link */
      .ul-link {
        position: relative;
        display: inline-block;
      }
      .ul-link::after {
        content: "";
        position: absolute;
        left: 0; right: 0; bottom: -3px;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform .45s cubic-bezier(.19,1,.22,1);
      }
      .ul-link:hover::after { transform: scaleX(1); }

      /* Swirl watermark */
      .swirl {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.06;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 800' preserveAspectRatio='none'><path d='M50 400 C 150 100, 350 100, 400 300 S 650 550, 750 300' fill='none' stroke='%23070707' stroke-width='2'/></svg>");
        background-size: cover;
        background-position: center;
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
        .reveal-mask > * { transform: none !important; }
        .script-wipe { clip-path: none !important; }
        .fade-up { opacity: 1; transform: none; }
      }
    </style>
  </head>

  <body class="bg-roast text-white antialiased overflow-x-hidden">
    <slot />

    <script is:inline>
      // ---- Reveal on scroll ----
      (function () {
        const els = document.querySelectorAll('.reveal-mask, .script-wipe, .fade-up');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      })();

      // ---- Dynamic header theme detection ----
      (function () {
        const header = document.getElementById('site-header');
        if (!header) return;
        const sections = () => document.querySelectorAll('[data-theme]');
        const apply = () => {
          const rect = header.getBoundingClientRect();
          const probeY = rect.top + rect.height / 2;
          let theme = 'dark';
          sections().forEach((s) => {
            const r = s.getBoundingClientRect();
            if (r.top <= probeY && r.bottom >= probeY) {
              theme = s.getAttribute('data-theme') || theme;
            }
          });
          header.setAttribute('data-current-theme', theme);
        };
        apply();
        window.addEventListener('scroll', apply, { passive: true });
        window.addEventListener('resize', apply);
      })();

      // ---- 3D cursor tilt ----
      (function () {
        const nodes = document.querySelectorAll('[data-tilt]');
        if (window.matchMedia('(hover: none)').matches) return;
        nodes.forEach((el) => {
          const strength = parseFloat(el.getAttribute('data-tilt')) || 8;
          let raf = null;
          const onMove = (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            if (raf) cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
              el.style.transform = `perspective(900px) rotateY(${x * strength}deg) rotateX(${-y * strength}deg) translateZ(0)`;
            });
          };
          const onLeave = () => {
            if (raf) cancelAnimationFrame(raf);
            el.style.transform = 'perspective(900px) rotateY(0deg) rotateX(0deg)';
          };
          el.addEventListener('mousemove', onMove);
          el.addEventListener('mouseleave', onLeave);
        });
      })();

      // ---- Mobile drawer ----
      (function () {
        const btn = document.getElementById('menu-toggle');
        const drawer = document.getElementById('mobile-drawer');
        if (!btn || !drawer) return;
        const close = () => {
          drawer.classList.add('pointer-events-none', 'opacity-0');
          drawer.classList.remove('opacity-100', 'pointer-events-auto');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };
        const open = () => {
          drawer.classList.remove('pointer-events-none', 'opacity-0');
          drawer.classList.add('opacity-100', 'pointer-events-auto');
          btn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };
        btn.addEventListener('click', () => {
          if (btn.getAttribute('aria-expanded') === 'true') close(); else open();
        });
        drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
      })();
    </script>
  </body>
</html>