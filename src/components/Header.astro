---
import { brand, nav } from '../data/site.js';
---
<header id="site-header" data-on="dark" class="fixed inset-x-5 top-4 z-50 sm:inset-x-10 sm:top-6">
  <nav aria-label="Primary" class="grid grid-cols-[1fr_auto_1fr] items-center">
    <div class="flex items-center">
      <ul class="hidden gap-7 font-mono text-[11px] tracking-wider lg:flex">
        {nav.map((l) => (
          <li><a href={l.href} class="link-u uppercase">{l.label}</a></li>
        ))}
      </ul>
      <button
        id="menu-toggle"
        type="button"
        class="group relative flex h-10 w-10 flex-col items-start justify-center gap-[7px] lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="drawer"
      >
        <span class="block h-px w-7 bg-current transition-transform duration-500 group-[.is-open]:translate-y-[4px] group-[.is-open]:rotate-45"></span>
        <span class="block h-px w-5 bg-current transition-all duration-500 group-[.is-open]:w-7 group-[.is-open]:-translate-y-[4px] group-[.is-open]:-rotate-45"></span>
      </button>
    </div>

    <a href="#top" class="flex items-center gap-2.5" aria-label="Fabuela Cafe & Brunch — home">
      <img
        src={brand.logo}
        alt=""
        referrerpolicy="no-referrer"
        width="36"
        height="36"
        class="h-8 w-8 rounded-full object-cover ring-1 ring-current sm:h-9 sm:w-9"
      />
      <span class="display text-lg sm:text-xl">Fabuela</span>
    </a>

    <div class="flex justify-end">
      <a href="#order" class="link-u flex items-center gap-2.5 font-mono text-[11px] tracking-wider">
        <span class="pulse" aria-hidden="true"></span>
        <span class="hidden sm:inline">ORDER AHEAD</span><span class="sm:hidden">ORDER</span>
      </a>
    </div>
  </nav>
</header>

<div
  id="drawer"
  class="fixed inset-0 z-40 flex flex-col justify-between bg-canvas px-5 pb-10 pt-28 text-white transition-[clip-path] duration-700 ease-[cubic-bezier(.76,0,.24,1)] sm:px-10 lg:hidden"
  style="clip-path: inset(0 0 100% 0)"
  aria-hidden="true"
  inert
>
  <ul class="space-y-3">
    {[...nav, { label: 'Instagram', href: '#instagram' }, { label: 'Order Ahead', href: '#order' }].map((l, i) => (
      <li class="border-b border-white/10 pb-3">
        <a href={l.href} class="flex items-baseline gap-4">
          <span class="font-mono text-[11px] text-white/35">{String(i + 1).padStart(2, '0')}</span>
          <span class="display text-[11vw] sm:text-6xl">{l.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="flex items-center justify-between font-mono text-[11px] text-white/50">
    <span>@{brand.handle}</span>
    <span class="font-arabic" lang="ckb" dir="rtl">فابوێلا کافێ</span>
  </div>
</div>