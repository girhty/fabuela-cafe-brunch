---
const links = [
  { label: 'Shop', href: '#shop', i: '01' },
  { label: 'Menu', href: '#menu', i: '02' },
  { label: 'Our Story', href: '#story', i: '03' },
  { label: 'Locations', href: '#locations', i: '04' },
];
---
<header id="siteHeader" class="fixed inset-x-4 sm:inset-x-10 top-4 sm:top-6 z-50 flex items-center justify-between transition-colors duration-500" data-theme="dark">
  <nav class="hidden lg:flex items-center gap-8 mono text-[11px] tracking-[0.22em] uppercase" aria-label="Primary">
    {links.map((l) => (
      <a href={l.href} class="ulink opacity-80 hover:opacity-100" data-nav>{l.label}</a>
    ))}
  </nav>

  <button id="menuToggle" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Open menu" aria-expanded="false">
    <span class="block w-6 h-px bg-current"></span>
    <span class="block w-6 h-px bg-current"></span>
  </button>

  <a href="#top" class="absolute left-1/2 -translate-x-1/2 display text-lg sm:text-2xl tracking-tight" aria-label="Fabuela home">
    FABUELA
  </a>

  <a href="#order" class="flex items-center gap-3 mono text-[11px] tracking-[0.25em] uppercase">
    <span class="hidden sm:inline">Order Online</span>
    <span class="sm:hidden">Order</span>
    <span class="dot-pulse" aria-hidden="true"></span>
  </a>
</header>

<div id="mobileDrawer" class="fixed inset-0 z-40 bg-ink text-white translate-y-full transition-transform duration-700 ease-[cubic-bezier(.16,1,.3,1)] hidden lg:hidden">
  <div class="h-full flex flex-col justify-between p-8 pt-28">
    <nav class="flex flex-col gap-2" aria-label="Mobile">
      {links.map((l) => (
        <a href={l.href} class="flex items-baseline gap-4 py-3 border-b border-white/10" data-drawer>
          <span class="mono text-xs text-white/35">{l.i}</span>
          <span class="display text-5xl tracking-tight">{l.label.toUpperCase()}</span>
        </a>
      ))}
    </nav>
    <div class="flex justify-between mono text-xs text-white/40 tracking-[0.25em] uppercase">
      <span>Erbil · Sulaymaniyah · Baghdad</span>
      <span>2026</span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const header = document.getElementById('siteHeader');
    const toggle = document.getElementById('menuToggle');
    const drawer = document.getElementById('mobileDrawer');
    const drawerLinks = drawer.querySelectorAll('[data-drawer]');

    const openDrawer = () => {
      drawer.classList.remove('hidden');
      requestAnimationFrame(() => drawer.style.transform = 'translateY(0)');
      document.body.classList.add('no-scroll');
      toggle.setAttribute('aria-expanded', 'true');
    };
    const closeDrawer = () => {
      drawer.style.transform = 'translateY(100%)';
      document.body.classList.remove('no-scroll');
      toggle.setAttribute('aria-expanded', 'false');
      setTimeout(() => drawer.classList.add('hidden'), 750);
    };
    toggle.addEventListener('click', () => {
      toggle.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer();
    });
    drawerLinks.forEach((l) => l.addEventListener('click', closeDrawer));

    // Dynamic theme detection based on section under header
    const sections = document.querySelectorAll('[data-surface]');
    const applyTheme = () => {
      const y = window.scrollY + 60;
      let theme = 'dark';
      sections.forEach((s) => {
        const top = s.offsetTop;
        const bottom = top + s.offsetHeight;
        if (y >= top && y < bottom) theme = s.getAttribute('data-surface');
      });
      if (header.getAttribute('data-theme') !== theme) {
        header.setAttribute('data-theme', theme);
        if (theme === 'light') {
          header.style.color = '#070707';
        } else {
          header.style.color = '#ffffff';
        }
      }
    };
    window.addEventListener('scroll', applyTheme, { passive: true });
    window.addEventListener('load', applyTheme);
    applyTheme();
  })();
</script>