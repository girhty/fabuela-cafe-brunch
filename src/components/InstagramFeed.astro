---
import { BRAND, IG_POSTS } from '../data/site.ts';
import Card from './Card.astro';

const followers = BRAND.followers.toLocaleString('en-US');
---

<section
  id="instagram"
  data-theme="dark"
  class="relative bg-roast py-24 sm:py-32 lg:py-40 overflow-hidden grain"
>
  <div class="relative z-10 px-6 sm:px-10 lg:px-12 max-w-[1440px] mx-auto">
    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-7">
        <div class="reveal-mask">
          <div class="font-mono text-[10.5px] tracking-[0.3em] text-white/55 mb-6">
            // FROM THE FEED
          </div>
        </div>
        <h2 class="font-display font-black leading-[0.9] tracking-[-0.045em] text-white text-[clamp(2rem,6.4vw,4.8rem)]">
          <span class="reveal-mask block"><span>TODAY AT</span></span>
          <span class="reveal-mask block"><span>@FABUELA.IQ.</span></span>
        </h2>
      </div>

      <div class="lg:col-span-5 lg:pl-10">
        <p class="reveal-mask">
          <span class="block font-sans text-sm leading-relaxed text-white/60 max-w-sm">
            New brunch plates, seasonal drinks, and after-hour workshops — captured and shared by our community every day.
          </span>
        </p>

        <div class="reveal-mask mt-8 flex items-center gap-5">
          <a
            href={BRAND.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 group"
          >
            <img
              src={BRAND.profilePic}
              alt={BRAND.name}
              referrerpolicy="no-referrer"
              class="h-11 w-11 rounded-full object-cover border border-white/20"
            />
            <div class="leading-none">
              <div class="font-mono text-[11px] tracking-[0.22em] text-white">{BRAND.instagramHandle}</div>
              <div class="font-mono text-[10px] tracking-[0.28em] text-white/45 mt-1.5">
                {followers} FOLLOWERS
              </div>
            </div>
          </a>

          <a
            href={BRAND.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-auto font-mono text-[11px] tracking-[0.24em] text-white ul-link group inline-flex items-center gap-2"
          >
            FOLLOW
            <span class="inline-block transition-transform duration-500 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Grid -->
    <div class="mt-14 sm:mt-20 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
      {IG_POSTS.map((p, i) => (
        <div class:list={[i === 0 && 'md:col-span-2 md:row-span-2']}>
          <Card
            variant="media"
            name={p.caption.slice(0, 40)}
            caption={p.caption}
            image={p.image}
            likes={p.likes}
            comments={p.comments}
            href={BRAND.instagramUrl}
          />
        </div>
      ))}
    </div>
  </div>
</section>