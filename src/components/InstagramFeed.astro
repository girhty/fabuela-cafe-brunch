---
const posts = [
  {
    caption: 'A little art therapy, the Fabuela way. 🎨✨',
    image: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/825276768_17946977154319753_4472395564808782037_n.jpg',
    likes: '1.2K',
    comments: '48',
  },
  {
    caption: 'Your sign to make today a brunch day. 🫰🏻',
    image: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/819021610_17946220923319753_4683366529875807962_n.jpg',
    likes: '986',
    comments: '32',
  },
  {
    caption: 'Brunch looks better when it’s Fabuela. 🫰🏻',
    image: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/818553715_17946039444319753_3913109193070269135_n.jpg',
    likes: '1.4K',
    comments: '67',
  },
  {
    caption: 'HOT DAYS. COLD DRINKS. GOOD MOOD.',
    image: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/814768822_17945634477319753_8327829479757198532_n.jpg',
    likes: '2.1K',
    comments: '84',
  },
  {
    caption: 'The secret behind every Fabuela bite. Our special sauces.',
    image: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/812781992_17945431161319753_7996202556433592933_n.jpg',
    likes: '1.6K',
    comments: '51',
  },
  {
    caption: 'Your Fabuela kind of morning. 🫰🏻',
    image: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/801304995_17944352034319753_3473979918832957175_n.jpg',
    likes: '1.9K',
    comments: '72',
  },
];
---
<section id="instagram" data-surface="dark" class="relative bg-ink overflow-hidden noise">
  <div class="relative max-w-[1440px] mx-auto px-6 sm:px-10 py-24 sm:py-32">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-8">
      <div>
        <div class="mono text-[11px] tracking-[0.3em] text-white/45 uppercase">// On Instagram</div>
        <h2 class="display text-[12vw] sm:text-[7vw] lg:text-[5rem] text-white mt-4 leading-[0.95]">
          <span class="line-mask"><span>@FABUELA.IQ</span></span>
        </h2>
        <div class="flex items-center gap-6 mt-6">
          <div class="flex items-center gap-3">
            <img src="https://scontent-ams2-1.cdninstagram.com/v/t51.2885-19/472606846_572910068875664_7740883200850795873_n.jpg" alt="Fabuela profile" class="w-10 h-10 rounded-full border border-white/20 object-cover" loading="lazy" />
            <div>
              <div class="text-white text-sm font-medium">FABUELA cafe &amp; brunch</div>
              <div class="mono text-[10px] tracking-[0.2em] text-white/40 uppercase">37,044 FOLLOWERS</div>
            </div>
          </div>
        </div>
      </div>
      <a href="https://instagram.com/fabuela.iq" target="_blank" rel="noopener" class="mono text-[11px] tracking-[0.3em] uppercase text-white/80 hover:text-white ulink">Follow →</a>
    </div>

    <div class="mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {posts.map((p) => (
        <a
          href="https://instagram.com/fabuela.iq"
          target="_blank"
          rel="noopener"
          class="group relative aspect-square overflow-hidden rounded-sm border border-white/10 reveal"
        >
          <img src={p.image} alt={p.caption} loading="lazy" class="w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="absolute inset-x-3 bottom-3 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
            <div class="flex items-center gap-3 mono text-[10px] tracking-[0.15em] text-white">
              <span>♥ {p.likes}</span>
              <span>💬 {p.comments}</span>
            </div>
            <p class="text-[10px] text-white/70 mt-1 line-clamp-2 leading-tight">{p.caption}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>