---
const cup = 'https://lh3.googleusercontent.com/grass-cs/ACvplmMiVGuyRzM99jjTFMMCIvKBRApl_AezNT49x0cHUIYZaVF-iikTfdL8prOLj-7VtIhJjk8m2OqdGTxJSochYFB4shopLSeMG5F-uRfsiyds4A24dzZeIynVQdrp-0SBsDTOaoZvV8DFZAoX=w600-h800-k-no';
const beans = Array.from({ length: 14 });
---
<section id="story" data-surface="dark" class="relative bg-ink overflow-hidden noise">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[70vw] h-[70vw] rounded-full blur-[180px] opacity-[0.22]" style="background: radial-gradient(circle, #6E3E22 0%, transparent 65%);"></div>
  </div>

  <div class="absolute inset-0 philosophy-scrim pointer-events-none"></div>

  <!-- Drifting beans -->
  <div class="absolute inset-0 pointer-events-none">
    {beans.map((_, i) => {
      const left = (i * 37) % 100;
      const top = (i * 61) % 100;
      const sz = 12 + (i % 5) * 8;
      const delay = (i * 1.3).toFixed(1);
      return (
        <div class="absolute animate-drift" style={`left:${left}%; top:${top}%; width:${sz}px; height:${sz * 1.5}px; animation-delay:-${delay}s; opacity:${0.12 + (i % 4) * 0.05};`}>
          <svg viewBox="0 0 20 30" class="w-full h-full">
            <ellipse cx="10" cy="15" rx="8" ry="14" fill="#C69B6E" />
            <path d="M10 2 Q6 15 10 28" stroke="#2C1A11" stroke-width="1.4" fill="none" />
          </svg>
        </div>
      );
    })}
  </div>

  <div class="relative z-10 max-w-[1440px] mx-auto px-6 sm:px-10 py-28 sm:py-40 min-h-[100vh] flex flex-col justify-between">
    <h2 class="display text-[10vw] sm:text-[6.5vw] lg:text-[5rem] xl:text-[5.8rem] text-white max-w-[16ch] leading-[0.95]">
      <span class="line-mask"><span>THE CITY NEVER STOPS.</span></span>
      <span class="line-mask"><span class="text-white/45">YOUR COFFEE</span></span>
      <span class="line-mask"><span class="text-white/45">SHOULDN'T SLOW</span></span>
      <span class="line-mask"><span class="text-white/45">YOU DOWN.</span></span>
    </h2>

    <!-- Floating cup -->
    <div class="my-16 flex justify-center">
      <div class="relative w-40 sm:w-56" data-tilt="12">
        <div class="absolute inset-0 -blur-3xl opacity-40 rounded-full" style="background: radial-gradient(circle, #C69B6E, transparent 70%);"></div>
        <div class="relative aspect-[3/4] overflow-hidden rounded-sm border border-white/10">
          <img src={cup} alt="Fabuela iced coffee" loading="lazy" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-3">
        <div class="mono text-[11px] tracking-[0.3em] text-white/45 uppercase">// Our Philosophy</div>
      </div>
      <p class="lg:col-span-6 text-sm leading-[1.9] text-white/60 max-w-lg">
        Stay for a conversation or leave with the cup in your hand — both work, neither takes any effort. Nothing here is rushed, and nothing keeps you longer than you meant to stay.
      </p>
      <div class="lg:col-span-3 lg:text-right mono text-[11px] tracking-[0.28em] uppercase text-white/80 leading-[2]">
        <div>Good coffee.</div>
        <div>No ceremony.</div>
        <div>No waiting.</div>
      </div>
    </div>
  </div>
</section>