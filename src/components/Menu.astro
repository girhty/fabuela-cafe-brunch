  {
    i: '01',
    name: 'ESPRESSO',
    price: '$2.50',
    note: 'DOUBLE / DRY',
    img: 'https://lh3.googleusercontent.com/grass-cs/ACvplmOfKML00wrMq-qOBh3ob0xwexT6W-CeP25fskIgDE1c63Bzno6eHU-6au_tPrYKsIx0FBNteStLMprlNBFws7eMZA3GzcC6KFrT_UfXU0Trr9xn28EBYHLJfxcUq1lTADmfgtEdrCPvq1kz=w600-h800-k-no',
  },
  {
    i: '02',
    name: 'LATTE',
    price: '$4.20',
    note: 'ROSETTA / OAT',
    img: 'https://lh3.googleusercontent.com/grass-cs/ACvplmMNLQFSBHa5QE5H67Wl7GIvH92hfSwdMBq1YQQFFs_miK75wo5_ivRFzx1htEc36TbGuT8pmnFhvK0KJb63to5RbkPDSaaqzYpm9CZki60Lt_Nqe2Wkdk39VZPrXwXG21D_xIABdIcUQTk=w600-h800-k-no',
  },
  {
    i: '03',
    name: 'ICED COFFEE',
    price: '$4.50',
    note: 'COLD BREW / ICE',
    img: 'https://lh3.googleusercontent.com/grass-cs/ACvplmMiVGuyRzM99jjTFMMCIvKBRApl_AezNT49x0cHUIYZaVF-iikTfdL8prOLj-7VtIhJjk8m2OqdGTxJSochYFB4shopLSeMG5F-uRfsiyds4A24dzZeIynVQdrp-0SBsDTOaoZvV8DFZAoX=w600-h800-k-no',
  },
  {
    i: '04',
    name: 'CINNAMON ROLL',
    price: '$3.80',
    note: 'FRESH / GLAZED',
    img: 'https://lh3.googleusercontent.com/grass-cs/ACvplmPxCl2wbcTiOt1EU9p7unHlaXdn2UI9c-5Ed1APTiIxqW6fGybrldrh1mg74UIFk13te9KPmTdx19AV_4HGn3fdvsUQ2MTAAD3Uf6On-e1WWio_vO5Td5HE31Vz34B76YYTvQGYxYYP8gM3=w600-h800-k-no',
  },
