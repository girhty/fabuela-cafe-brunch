---
import { menu, brand } from '../data/site.js';
---
<section
  id="menu"
  data-theme="light"
  data-reveal
  aria-labelledby="menu-title"
  class="relative overflow-hidden bg-bone py-24 text-canvas sm:py-32"
>
  <!-- Brand swirl -->
  <svg class="pointer-events-none absolute -right-40 -top-20 h-[900px] w-[1300px] text-oat" viewBox="0 0 1300 900" fill="none" aria-hidden="true">
    <path d="M40 700 C 240 420, 520 900, 700 560 S 1000 120, 1260 380" stroke="currentColor" stroke-width="140" stroke-linecap="round" />
  </svg>

  <div class="relative mx-auto max-w-[1440px] px-5 sm:px-10">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow fade-up text-canvas/60">Our menu</p>
        <h2 id="menu-title" class="display mt-5 text-[13vw] sm:text-[9vw] lg:text-[clamp(64px,7vw,112px)]">
          <span class="mask"><span>Favorites</span></span>
          <span class="mask"><span style="--d:120ms">made daily</span></span>
        </h2>
        <p class="fade-up mt-5 max-w-sm text-[15px] leading-relaxed text-canvas/55 lg:ml-[38%]" style="--d:300ms">
          Brunch plates built on fresh bread, crispy bacon and our secret special sauces. Simple, balanced, and made to be finished.
        </p>
      </div>

      <div class="group relative self-start lg:self-end">
        <a href={brand.igUrl} target="_blank" rel="noopener" class="link-cta relative z-10 font-mono text-[12px] tracking-wider">
          VIEW FULL MENU <span class="arr" aria-hidden="true">→</span>
        </a>
        <!-- Receipt easter egg -->
        <div class="pointer-events-none absolute -right-4 bottom-8 z-0 w-44 translate-y-10 rotate-6 bg-[#F7F5EF] p-4 font-mono text-[9px] leading-relaxed text-canvas opacity-0 shadow-[0_20px_40px_-10px_rgba(0,0,0,.35)] transition-all duration-700 ease-[cubic-bezier(.34,1.4,.64,1)] group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100" aria-hidden="true">
          <p class="display text-center text-sm">FABUELA</p>
          <div class="perf my-2"></div>
          {menu.map((m) => (<p class="flex justify-between"><span>{m.name}</span><span>x1</span></p>))}
          <div class="perf my-2"></div>
          <p class="text-center">MADE FRESH · 🫰🏻</p>
        </div>
      </div>
    </div>

    <div class="mt-20 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {menu.map((item, i) => (
        <article
          data-tilt
          data-tilt-max="6"
          class="tilt fade-up group relative flex min-h-[440px] flex-col border border-canvas bg-bone"
          style={`--d:${i * 110}ms`}
        >
          <div class="flex items-center justify-between p-5 font-mono text-[11px]">
            <span class="text-canvas/40">{item.index}</span>
            <span class="text-canvas/40">{item.kind}</span>
          </div>
          <div class={`relative flex flex-1 items-center justify-center px-6 ${item.tall ? '-mt-24' : ''}`}>
            <div data-parallax="-0.05" class="w-full">
              <div class={`overflow-hidden shadow-[0_30px_50px_-20px_rgba(10,12,8,.45)] transition-transform duration-700 ease-[cubic-bezier(.34,1.4,.64,1)] group-hover:-translate-y-2 group-hover:scale-[1.03] ${item.tall ? 'aspect-[3/5] rounded-[999px_999px_20px_20px] mx-auto w-[74%]' : 'aspect-square rounded-full'}`}>
                <img src={item.image} alt={item.alt} referrerpolicy="no-referrer" loading="lazy" class="h-full w-full object-cover" width="480" height="480" />
              </div>
            </div>
          </div>
          <div class="mt-4 flex items-end justify-between border-t border-canvas p-5">
            <h3 class="display text-2xl">{item.name}</h3>
            <span class="mask font-mono text-[11px]"><span style={`--d:${300 + i * 110}ms`}>{item.tag}</span></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>