---
import { MENU_ITEMS } from '../data/site.ts';
import Card from './Card.astro';
---

<section
  id="menu"
  data-theme="light"
  class="relative bg-bone text-[#070707] py-24 sm:py-32 lg:py-40 overflow-hidden"
>
  <!-- Oversized swirl watermark -->
  <div class="swirl" aria-hidden="true"></div>

  <div class="relative z-10 px-6 sm:px-10 lg:px-12 max-w-[1440px] mx-auto">
    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-7">
        <div class="reveal-mask">
          <div class="font-mono text-[10.5px] tracking-[0.3em] text-[#070707]/55 mb-6">
            // OUR MENU
          </div>
        </div>
        <h2 class="font-display font-black leading-[0.88] tracking-[-0.045em] text-[#070707] text-[clamp(2.2rem,7.4vw,5.6rem)]">
          <span class="reveal-mask block"><span>FAVORITES</span></span>
          <span class="reveal-mask block"><span>MADE DAILY.</span></span>
        </h2>
      </div>

      <div class="lg:col-span-5 lg:pl-10">
        <p class="reveal-mask">
          <span class="block font-sans text-sm leading-relaxed text-[#070707]/60 max-w-sm">
            Quality ingredients, carefully prepared. Simple, balanced, and plated to be enjoyed — every single day, breakfast through brunch.
          </span>
        </p>

        <div class="reveal-mask mt-8 relative">
          <div
            class="group inline-flex items-center gap-3 font-mono text-[12px] tracking-[0.28em] text-[#070707] ul-link cursor-pointer"
          >
            <span>VIEW FULL MENU</span>
            <span class="inline-block transition-transform duration-500 group-hover:translate-x-1.5">→</span>

            <!-- Receipt easter egg -->
            <div class="receipt-pop absolute -right-2 -top-2 translate-y-6 rotate-[5deg] opacity-0 pointer-events-none transition-all duration-500 ease-out">
              <div class="w-[180px] bg-[#f4f0e8] text-[#070707] receipt-shadow rounded-t-[2px] px-3 pt-3 pb-2">
                <div class="font-display font-black text-[11px] tracking-[0.03em] text-center">
                  FABUELA
                </div>
                <div class="font-mono text-[7.5px] tracking-[0.3em] text-center text-[#070707]/55 mt-0.5">
                  CAFE &amp; BRUNCH
                </div>
                <div class="border-t border-dashed border-[#070707]/30 my-2"></div>
                <div class="font-mono text-[8px] tracking-[0.08em] text-[#070707]/70 leading-relaxed">
                  EGGS BENEDICT × 2<br />
                  GREENX JUICE × 2<br />
                  FLAT WHITE × 2
                </div>
                <div class="border-t border-dashed border-[#070707]/30 my-2"></div>
                <div class="font-mono text-[8px] flex justify-between text-[#070707]">
                  <span>TOTAL</span><span>IQD 55,000</span>
                </div>
              </div>
              <div class="receipt-zigzag w-[180px]"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Cards -->
    <div class="mt-14 sm:mt-20 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {MENU_ITEMS.map((item) => (
        <Card
          variant="menu"
          index={item.index}
          name={item.name}
          price={item.price}
          image={item.image}
          tag={item.tag}
          rotate={item.rotate}
        />
      ))}
    </div>

    <!-- Marquee strip -->
    <div class="mt-20 sm:mt-24 border-y border-[#070707]/15 overflow-hidden">
      <div class="flex animate-marquee whitespace-nowrap py-4">
        {Array.from({ length: 2 }).map(() => (
          <div class="flex items-center">
            {[
              'BRUNCH ALL DAY',
              'SPECIALTY COFFEE',
              'FRESH EVERY MORNING',
              'THREE CITIES',
              'MADE FOR MOMENTS',
            ].map((t) => (
              <span class="flex items-center">
                <span class="font-display font-black text-2xl sm:text-3xl tracking-[-0.02em] text-[#070707]/85 px-8">
                  {t}
                </span>
                <span class="text-crema text-2xl sm:text-3xl">✦</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .receipt-pop { transform-origin: top right; }
  .group:hover .receipt-pop {
    opacity: 1;
    transform: translate(0, 0) rotate(-2deg);
  }
</style>