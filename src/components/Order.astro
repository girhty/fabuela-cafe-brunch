---
import { photos, contact, menu } from '../data/site.js';
let seed = 3;
const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
let x = 0;
const bars = [];
while (x < 196) {
  const w = 1 + Math.floor(rnd() * 3.5);
  bars.push({ x, w });
  x += w + 1 + Math.floor(rnd() * 3);
}
---
<section id="order" data-theme="dark" aria-labelledby="order-title" class="relative h-[240vh] bg-canvas text-white">
  <div class="sticky top-0 h-[100svh] overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <div data-parallax="0.12" class="absolute -inset-[10%]">
        <img src={photos[0]} alt="" referrerpolicy="no-referrer" loading="lazy" class="h-full w-full scale-110 object-cover blur-[2px]" />
      </div>
      <div class="absolute inset-0 bg-canvas/70"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,rgba(10,12,8,.85)_80%)]"></div>
    </div>

    <!-- Printer -->
    <div class="absolute left-1/2 top-0 z-20 w-[300px] -translate-x-1/2 sm:w-[340px]" aria-hidden="true">
      <div class="h-12 rounded-b-2xl bg-[linear-gradient(180deg,#2a2d27,#121410)] shadow-[0_20px_40px_rgba(0,0,0,.6)] ring-1 ring-white/10">
        <div class="mx-auto flex h-full w-[86%] items-end pb-2">
          <div class="h-[5px] w-full rounded-full bg-black shadow-[inset_0_2px_3px_rgba(0,0,0,1)]"></div>
        </div>
      </div>
      <div class="absolute right-4 top-3 flex items-center gap-1.5"><span class="pulse" style="width:5px;height:5px"></span></div>
    </div>

    <!-- Receipt feed -->
    <div class="absolute left-1/2 top-[42px] z-10 h-[calc(100svh-42px)] w-[272px] origin-top -translate-x-1/2 scale-[.78] overflow-hidden sm:scale-90 lg:scale-100">
      <div id="receipt" class="drop-shadow-[0_30px_40px_rgba(0,0,0,.55)]" style="transform: translateY(-100%)">
        <div class="bg-[#F7F5EF] px-6 pb-6 pt-8 font-mono text-[10px] uppercase leading-relaxed text-canvas">
          <p class="display text-center text-3xl">Fabuela</p>
          <p class="text-center text-[9px] tracking-[.25em] text-canvas/60">Cafe &amp; Brunch · Erbil</p>
          <div class="perf my-4"></div>
          <svg viewBox="0 0 60 70" class="mx-auto h-14 w-12" fill="none" stroke="#0A0C08" stroke-width="1.6" aria-hidden="true">
            <path d="M10 18 H50 L45 64 H15 Z" stroke-linejoin="round" />
            <path d="M7 12 H53 V18 H7 Z" stroke-linejoin="round" />
            <path d="M12 12 L15 6 H45 L48 12" stroke-linejoin="round" />
            <path d="M12 34 H48" />
          </svg>
          <p class="mt-3 text-center">Good brunch.<br />Made for your day.</p>
          <div class="perf my-4"></div>
          <div class="flex justify-between"><span>Order #00025</span><span id="r-time">12:45</span></div>
          <div class="flex justify-between"><span>Date</span><span id="r-date">03/10/2026</span></div>
          <div class="perf my-4"></div>
          {menu.map((m) => (<div class="flex justify-between"><span>{m.name}</span><span>x1</span></div>))}
          <div class="mt-2 flex justify-between font-medium"><span>Total</span><span>Made fresh</span></div>
          <div class="perf my-4"></div>
          <p class="text-center">Thank you for choosing us.<br />See you soon! 🫰🏻</p>
          <div class="mt-5 bg-canvas p-4 text-center text-bone">
            <p class="display text-lg leading-none">Skip the line.<br />Order ahead.</p>
            <p class="mt-2 text-[9px] text-bone/60">Save time. Get your brunch faster.</p>
            <a href={contact.tel} class="mt-3 inline-block bg-bone px-4 py-2 text-[10px] font-medium text-canvas transition hover:bg-accent">ORDER NOW →</a>
          </div>
          <svg id="barcode" viewBox="0 0 196 44" class="mt-5 h-11 w-full" aria-hidden="true">
            {bars.map((b, i) => (<rect class="bar" style={`--i:${i}`} x={b.x} y="0" width={b.w} height="44" fill="#0A0C08" />))}
          </svg>
          <p class="mt-1 text-center tracking-[.3em]">@FABUELA.IQ</p>
        </div>
        <div class="zigzag"></div>
      </div>
    </div>

    <!-- Surrounding copy -->
    <div class="absolute inset-x-5 bottom-8 z-20 grid grid-cols-1 gap-6 sm:inset-x-10 sm:bottom-10 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-4">
        <h2 id="order-title" class="display text-[11vw] sm:text-6xl lg:text-[clamp(44px,4.4vw,72px)]">
          <span class="mask"><span>Brunch for</span></span>
          <span class="mask"><span style="--d:120ms">right now.</span></span>
        </h2>
        <p class="fade-up mt-4 font-mono text-[11px] tracking-wider text-white/55" style="--d:250ms">WE HANDLE THE CRAFT. YOU HANDLE THE DAY.</p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
        <p class="fade-up hidden font-mono text-[11px] uppercase leading-relaxed text-white/60 sm:block" style="--d:300ms">
          We work to one schedule: yours. Call ahead or order through your favourite delivery app — your French toast is plated to meet you, not to sit waiting.
        </p>
        <a href={contact.tel} class="link-cta fade-up mt-5 font-mono text-[12px] tracking-wider text-white" style="--d:400ms">ORDER RIGHT NOW <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>