---
import { BRAND } from '../data/site.ts';
---

<section
  id="order"
  data-theme="dark"
  class="relative bg-roast py-24 sm:py-32 lg:py-40 overflow-hidden grain"
>
  <!-- Ambient photo backdrop -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <img
      src="https://lh3.googleusercontent.com/grass-cs/AABkmLfGfYHr6ZDWXMy7lVq0q1lJuZaxEIm2-pX6JjQekl6O9CaaZyFbH1gUddhanW1QFKBdERPVsm3j1DxpI3Hbbgi0wIG0xtkzAgU4Ci7ZsWFS6-7NAkdUdcf6Mzq3f8GML84DKJB-reWG5MY=w408-h544-k-no"
      alt=""
      referrerpolicy="no-referrer"
      class="h-full w-full object-cover opacity-20"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #070707 0%, rgba(7,7,7,0.75) 30%, rgba(7,7,7,0.75) 70%, #070707 100%);"></div>
  </div>

  <div class="relative z-10 px-6 sm:px-10 lg:px-12 max-w-[1440px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- Left copy -->
      <div class="lg:col-span-4">
        <div class="reveal-mask mb-6">
          <div class="font-mono text-[10.5px] tracking-[0.3em] text-white/55">
            // ORDER AHEAD
          </div>
        </div>
        <h2 class="font-display font-black leading-[0.9] tracking-[-0.045em] text-white text-[clamp(2rem,6vw,4.4rem)]">
          <span class="reveal-mask block"><span>BRUNCH FOR</span></span>
          <span class="reveal-mask block"><span>RIGHT NOW.</span></span>
        </h2>

        <p class="reveal-mask mt-8">
          <span class="block font-mono text-[11px] tracking-[0.28em] text-white/60 uppercase leading-relaxed">
            WE HANDLE THE CRAFT.<br />YOU HANDLE THE DAY.
          </span>
        </p>
      </div>

      <!-- Receipt -->
      <div class="lg:col-span-4 flex justify-center">
        <div class="relative w-full max-w-[360px]">
          <!-- Printer slot -->
          <div class="relative z-20 flex justify-center">
            <div class="w-[78%] h-3 rounded-full bg-gradient-to-b from-[#1a1a18] to-[#0a0a09] border border-white/10 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]"></div>
          </div>

          <!-- Receipt paper -->
          <div class="relative z-10 -mt-1.5 mx-auto w-[86%] overflow-hidden">
            <div class="bg-[#f4f0e8] text-[#070707] receipt-shadow rounded-t-[2px] px-6 pt-6 pb-2">
              <div class="text-center">
                <div class="font-display font-black text-lg tracking-[0.02em]">FABUELA</div>
                <div class="font-mono text-[8.5px] tracking-[0.32em] text-[#070707]/55 mt-1">
                  CAFE &amp; BRUNCH
                </div>
                <div class="font-mono text-[8.5px] tracking-[0.24em] text-[#070707]/55 mt-0.5">
                  ERBIL · SULAYMANIYAH · BAGHDAD
                </div>
              </div>

              <div class="border-t border-dashed border-[#070707]/35 my-4"></div>

              <div class="font-mono text-[9.5px] leading-relaxed text-[#070707]/75 tracking-[0.06em]">
                GOOD BRUNCH.<br />MADE FOR YOUR DAY.
              </div>

              <div class="my-4 flex justify-center">
                <svg width="42" height="42" viewBox="0 0 60 60" fill="none" stroke="#070707" stroke-width="1.4" aria-hidden="true">
                  <path d="M14 22 h28 v20 a8 8 0 0 1 -8 8 h-12 a8 8 0 0 1 -8 -8 z" />
                  <path d="M42 26 h5 a5 5 0 0 1 0 12 h-5" />
                  <path d="M18 14 q2 -4 0 -8 M28 14 q2 -4 0 -8 M38 14 q2 -4 0 -8" stroke-linecap="round" />
                </svg>
              </div>

              <div class="border-t border-dashed border-[#070707]/35 my-4"></div>

              <div class="font-mono text-[9px] text-[#070707]/85 tracking-[0.08em] flex justify-between">
                <span>ORDER ID</span><span>#00025</span>
              </div>
              <div class="font-mono text-[9px] text-[#070707]/85 tracking-[0.08em] flex justify-between mt-1.5">
                <span>DATE</span><span>21 / 05 / 2026</span>
              </div>
              <div class="font-mono text-[9px] text-[#070707]/85 tracking-[0.08em] flex justify-between mt-1.5">
                <span>READY AT</span><span>12:45</span>
              </div>

              <div class="border-t border-dashed border-[#070707]/35 my-4"></div>

              <div class="text-center">
                <div class="font-display font-black text-[15px] tracking-[-0.01em] text-[#070707]">
                  SKIP THE LINE.
                </div>
                <div class="font-display font-black text-[15px] tracking-[-0.01em] text-[#070707] mt-0.5">
                  ORDER AHEAD.
                </div>
                <div class="font-mono text-[8.5px] tracking-[0.24em] text-[#070707]/55 mt-2">
                  SAVE TIME · GET SERVED FASTER
                </div>
              </div>

              <div class="mt-4">
                <a
                  href="#menu"
                  class="block text-center bg-[#070707] text-[#f4f0e8] font-mono text-[11px] tracking-[0.28em] py-3 rounded-[2px] hover:bg-[#1a1a18] transition-colors"
                >
                  ORDER NOW →
                </a>
              </div>

              <div class="mt-5 text-center">
                <div class="font-mono text-[8px] tracking-[0.32em] text-[#070707]/45">
                  THANK YOU · SEE YOU SOON
                </div>
              </div>

              <div class="mt-4 mx-auto w-[86%] h-10" aria-hidden="true">
                <svg viewBox="0 0 200 40" width="100%" height="100%" preserveAspectRatio="none">
                  {[2, 5, 3, 8, 2, 6, 10, 3, 5, 2, 8, 3, 4, 2, 7, 3, 9, 2, 5, 4, 8, 3, 2, 6].map(
                    (w, i) => {
                      const x = i * 8.2 + 4;
                      return (
                        <rect
                          x={x}
                          y="4"
                          width={w}
                          height="32"
                          fill="#070707"
                        />
                      );
                    }
                  )}
                </svg>
              </div>

              <div class="font-mono text-[8px] tracking-[0.3em] text-center text-[#070707]/45 pb-1">
                fabuela.iq
              </div>
            </div>
            <div class="receipt-zigzag w-full"></div>
          </div>
        </div>
      </div>

      <!-- Right copy -->
      <div class="lg:col-span-4 lg:pl-4">
        <p class="reveal-mask">
          <span class="block font-sans text-[14.5px] leading-relaxed text-white/65 max-w-md">
            We work to one schedule: yours. Order ahead and your plate is plated to meet you the moment you walk in — not to sit waiting under a lamp.
          </span>
        </p>

        <div class="reveal-mask mt-8">
          <a
            href={BRAND.phoneHref}
            class="inline-flex items-center gap-3 font-mono text-[12px] tracking-[0.28em] text-white ul-link group"
          >
            <span>ORDER RIGHT NOW</span>
            <span class="inline-block transition-transform duration-500 group-hover:translate-x-1.5">→</span>
          </a>
        </div>

        <div class="reveal-mask mt-10 border-t border-white/12 pt-6">
          <div class="font-mono text-[9.5px] tracking-[0.3em] text-white/40">DIRECT LINE</div>
          <a
            href={BRAND.phoneHref}
            class="font-mono text-[13px] tracking-[0.18em] text-white mt-2 ul-link block"
          >
            {BRAND.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>