---
import { brand } from '../data/site.js';
---
<div
  id="preloader"
  class="fixed inset-0 z-[100] flex flex-col justify-between bg-canvas p-5 text-white sm:p-10"
  role="status"
  aria-label="Loading Fabuela"
>
  <div class="flex items-center justify-between">
    <p class="eyebrow text-white/60">Now brewing</p>
    <p class="font-mono text-[10px] tracking-wider text-white/35">ERBIL · EMPIRE PEARL P7</p>
  </div>

  <div class="flex justify-center">
    <span id="pl-count" class="display tabular-nums text-[30vw] leading-none sm:text-[19vw]">000</span>
  </div>

  <div class="flex items-end justify-between gap-6">
    <div class="flex items-center gap-3">
      <img
        src={brand.logo}
        alt="Fabuela logo"
        referrerpolicy="no-referrer"
        width="56"
        height="56"
        class="h-12 w-12 rounded-full object-cover ring-1 ring-white/30 sm:h-14 sm:w-14"
      />
      <div>
        <p class="display text-2xl sm:text-3xl">Fabuela</p>
        <p class="font-mono text-[10px] tracking-widest text-white/40">CAFE &amp; BRUNCH · <span class="font-arabic" lang="ckb" dir="rtl">فابوێلا کافێ</span></p>
      </div>
    </div>

    <svg id="pl-cup" viewBox="0 0 80 112" class="w-14 sm:w-20" aria-hidden="true">
      <defs>
        <clipPath id="cupClip"><path d="M13 24 L67 24 L60 106 L20 106 Z" /></clipPath>
        <linearGradient id="liq" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#E6CB93" />
          <stop offset=".12" stop-color="#C7A26A" />
          <stop offset=".45" stop-color="#6B4A2C" />
          <stop offset="1" stop-color="#1E130A" />
        </linearGradient>
      </defs>
      <g clip-path="url(#cupClip)">
        <rect id="pl-liquid" x="-20" y="104" width="120" height="120" fill="url(#liq)" />
      </g>
      <path d="M13 24 L67 24 L60 106 L20 106 Z" fill="none" stroke="white" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M9 16 H71 V24 H9 Z" fill="none" stroke="white" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M15 16 L19 8 H61 L65 16" fill="none" stroke="white" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M16 48 H64 M15 70 H62" stroke="white" stroke-opacity=".35" stroke-width="1" />
    </svg>
  </div>
</div>