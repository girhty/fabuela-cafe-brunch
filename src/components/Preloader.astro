---
import { BRAND } from '../data/site.ts';
---

<div
  id="preloader"
  class="fixed inset-0 z-[100] bg-[#070707] text-white grain"
  aria-hidden="true"
>
  <div class="relative h-full w-full px-6 sm:px-10 py-6 sm:py-8 flex flex-col justify-between">
    <div class="flex items-center justify-between">
      <div class="font-mono text-[10px] sm:text-[11px] tracking-[0.25em] text-white/55">
        // NOW BREWING
      </div>
      <div class="font-mono text-[10px] tracking-[0.25em] text-white/35">
        FABUELA · 07:00
      </div>
    </div>

    <div class="flex items-center justify-center">
      <div
        id="pre-count"
        class="font-display font-black leading-[0.85] tracking-[-0.06em] tabular-nums text-[26vw] sm:text-[20vw] lg:text-[16rem]"
      >
        000
      </div>
    </div>

    <div class="flex items-end justify-between gap-6">
      <div class="flex items-center gap-3">
        <img
          src={BRAND.profilePic}
          alt={BRAND.name}
          referrerpolicy="no-referrer"
          loading="eager"
          class="h-10 w-10 rounded-full object-cover border border-white/20"
        />
        <div>
          <div class="font-display font-black text-base sm:text-lg leading-none tracking-[-0.02em]">
            FABUELA
          </div>
          <div class="font-mono text-[9px] tracking-[0.3em] text-white/40 mt-1">
            CAFE &amp; BRUNCH
          </div>
        </div>
      </div>

      <div class="cup" aria-hidden="true">
        <div class="cup-fill" id="pre-fill"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const el = document.getElementById('preloader');
    const countEl = document.getElementById('pre-count');
    const fillEl = document.getElementById('pre-fill');
    if (!el || !countEl || !fillEl) return;

    let v = 0;
    const target = 100;
    const step = () => {
      v += Math.max(1, Math.round(Math.random() * 4));
      if (v > target) v = target;
      countEl.textContent = String(v).padStart(3, '0');
      fillEl.style.height = v + '%';
      if (v < target) {
        setTimeout(step, 24 + Math.random() * 40);
      } else {
        setTimeout(() => {
          el.style.transition = 'clip-path 1.05s cubic-bezier(.76,0,.24,1)';
          el.style.clipPath = 'inset(100% 0 0 0)';
          document.body.style.overflow = '';
          setTimeout(() => el.remove(), 1200);
        }, 320);
      }
    };
    document.body.style.overflow = 'hidden';
    setTimeout(step, 220);

    window.addEventListener('load', () => {
      if (v < target) v = Math.max(v, target - 8);
    });
  })();
</script>