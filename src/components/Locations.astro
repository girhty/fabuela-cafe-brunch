---
import { locations, posts, contact } from '../data/site.js';
const cx = 200, cy = 200;
const ticks = Array.from({ length: 60 }, (_, i) => {
  const a = (i / 60) * Math.PI * 2;
  const r1 = 192, r2 = i % 5 === 0 ? 172 : 182;
  return { x1: cx + r1 * Math.sin(a), y1: cy - r1 * Math.cos(a), x2: cx + r2 * Math.sin(a), y2: cy - r2 * Math.cos(a), major: i % 5 === 0 };
});
const nums = Array.from({ length: 12 }, (_, i) => {
  const n = i === 0 ? 12 : i;
  const a = (i / 12) * Math.PI * 2;
  return { n: String(n).padStart(2, '0'), x: cx + 150 * Math.sin(a), y: cy - 150 * Math.cos(a) };
});
const cup = posts[8];
---
<section
  id="locations"
  data-theme="light"
  data-reveal
  aria-labelledby="loc-title"
  class="relative overflow-hidden border-t border-canvas/10 bg-bone py-24 text-canvas sm:py-32"
>
  <svg class="pointer-events-none absolute -left-60 bottom-0 h-[800px] w-[1300px] text-oat" viewBox="0 0 1300 800" fill="none" aria-hidden="true">
    <path d="M1260 120 C 1000 420, 760 -60, 560 300 S 240 760, 40 520" stroke="currentColor" stroke-width="130" stroke-linecap="round" />
  </svg>

  <div class="relative mx-auto grid max-w-[1440px] grid-cols-1 gap-16 px-5 sm:px-10 lg:grid-cols-12 lg:gap-8">
    <div class="flex flex-col justify-between gap-12 lg:col-span-4">
      <div>
        <p class="fade-up flex items-center gap-3 font-mono text-[11px] tracking-wider"><span class="pulse" aria-hidden="true"></span> OUR LOCATIONS</p>
        <h2 id="loc-title" class="display mt-6 text-[12vw] sm:text-7xl lg:text-[clamp(52px,5vw,84px)]">
          <span class="mask"><span>One city.</span></span>
          <span class="mask"><span style="--d:120ms">Three soon.</span></span>
        </h2>
      </div>

      <ul class="space-y-6">
        {locations.map((l, i) => (
          <li class="fade-up border-t border-canvas/15 pt-4 font-mono text-[12px] uppercase leading-relaxed" style={`--d:${200 + i * 120}ms`}>
            <p class="flex items-center justify-between">
              <span class="text-canvas">{l.city}</span>
              <span class={l.open ? 'rounded-full bg-canvas px-2 py-0.5 text-[10px] text-accent' : 'text-[10px] text-canvas/40'}>{l.status}</span>
            </p>
            {l.lines.map((line) => (<p class="text-canvas/50">{line}</p>))}
          </li>
        ))}
      </ul>
    </div>

    <!-- Dial -->
    <div class="relative flex items-center justify-center lg:col-span-5" aria-hidden="true">
      <div data-parallax="0.06" class="relative aspect-square w-full max-w-[520px]">
        <svg viewBox="0 0 400 400" class="absolute inset-0 h-full w-full">
          <circle cx="200" cy="200" r="196" fill="none" stroke="#0A0C08" stroke-width="1" />
          <circle cx="200" cy="200" r="126" fill="none" stroke="#0A0C08" stroke-opacity=".25" stroke-dasharray="2 4" />
          {ticks.map((t) => (
            <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="#0A0C08" stroke-width={t.major ? 1.6 : .7} stroke-opacity={t.major ? 1 : .5} />
          ))}
          {nums.map((n) => (
            <text x={n.x} y={n.y} text-anchor="middle" dominant-baseline="central" font-family="JetBrains Mono, monospace" font-size="11" fill="#0A0C08">{n.n}</text>
          ))}
          <text x="200" y="62" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="7" letter-spacing="2" fill="#0A0C08" fill-opacity=".45">36.19°N · 44.01°E</text>
        </svg>
        <div data-dial-cup class="absolute inset-0 flex items-center justify-center">
          <div class="absolute left-1/2 top-[9%] h-[20%] w-[2px] -translate-x-1/2 bg-canvas"></div>
          <div class="relative h-[48%] w-[34%] overflow-hidden rounded-[999px_999px_24px_24px] shadow-[0_30px_60px_-15px_rgba(10,12,8,.5)] ring-1 ring-canvas">
            <img src={cup.image} alt="" referrerpolicy="no-referrer" loading="lazy" class="h-full w-full object-cover" width="300" height="420" />
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col justify-end gap-8 lg:col-span-3">
      <div class="fade-up font-mono text-[12px] uppercase" style="--d:300ms">
        <p class="text-canvas/40">Hours</p>
        <p class="mt-1 text-canvas">Open now</p>
        <p class="text-canvas">Brunch all day</p>
      </div>
      <div class="fade-up font-mono text-[12px] uppercase" style="--d:400ms">
        <p class="text-canvas/40">Reservations</p>
        <a href={contact.tel} class="link-u mt-1 text-canvas">{contact.phone}</a>
      </div>
      <a href={contact.mapsUrl} target="_blank" rel="noopener" class="link-cta fade-up self-start font-mono text-[12px] tracking-wider" style="--d:500ms">GET DIRECTIONS <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>