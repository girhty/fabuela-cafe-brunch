---
const branches = [
  { city: 'Erbil — HQ', line1: 'Empire Pearl P7', line2: 'Erbil, Kurdistan' },
  { city: 'Sulaymaniyah', line1: 'Grand Boulevard', line2: 'Sulaymaniyah, KRI' },
  { city: 'Baghdad', line1: 'Mansur — Al Dawoodi', line2: 'Baghdad, Iraq' },
];
const cupImage = 'https://lh3.googleusercontent.com/grass-cs/ACvplmMNLQFSBHa5QE5H67Wl7GIvH92hfSwdMBq1YQQFFs_miK75wo5_ivRFzx1htEc36TbGuT8pmnFhvK0KJb63to5RbkPDSaaqzYpm9CZki60Lt_Nqe2Wkdk39VZPrXwXG21D_xIABdIcUQTk=w600-h800-k-no';
---
<section id="locations" data-surface="light" class="relative bg-cream text-ink overflow-hidden">
  <div class="relative max-w-[1440px] mx-auto px-6 sm:px-10 py-24 sm:py-32">
    <div class="flex items-center gap-3 mono text-[11px] tracking-[0.3em] text-ink/60 uppercase">
      <span class="dot-pulse" style="background:#B07A45"></span>
      <span>Our Locations</span>
    </div>

    <div class="mt-12 grid lg:grid-cols-12 gap-12 items-center">
      <!-- Branch list -->
      <div class="lg:col-span-5 flex flex-col gap-10 order-2 lg:order-1">
        <ul class="flex flex-col divide-y divide-ink/15 border-t border-b border-ink/15">
          {branches.map((b, i) => (
            <li class="reveal py-6 flex justify-between items-baseline gap-6" style={`transition-delay:${i * 90}ms`}>
              <div>
                <div class="display text-2xl sm:text-3xl tracking-tight">{b.city}</div>
                <div class="mono text-[11px] tracking-[0.25em] text-ink/50 uppercase mt-1">{b.line1}</div>
                <div class="mono text-[11px] tracking-[0.25em] text-ink/40 uppercase">{b.line2}</div>
              </div>
              <span class="mono text-[10px] tracking-[0.25em] text-ink/40">0{i + 1}</span>
            </li>
          ))}
        </ul>

        <div class="flex items-end justify-between">
          <div>
            <div class="mono text-[10px] tracking-[0.3em] text-ink/40 uppercase">Open Daily</div>
            <div class="display text-3xl sm:text-4xl mt-1 tracking-tight">07:00 — 21:00</div>
          </div>
          <a href="https://maps.google.com/?q=Fabuela+Cafe+Erbil" target="_blank" rel="noopener" class="mono text-[11px] tracking-[0.28em] uppercase text-ink/70 ulink">Map →</a>
        </div>
      </div>

      <!-- Clock dial -->
      <div class="lg:col-span-7 order-1 lg:order-2">
        <div id="dialWrap" class="relative mx-auto max-w-[560px] aspect-square">
          <svg viewBox="0 0 400 400" class="absolute inset-0 w-full h-full">
            <defs>
              <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#070707" stop-opacity="0.12" />
                <stop offset="100%" stop-color="#070707" stop-opacity="0.02" />
              </linearGradient>
            </defs>
            <circle cx="200" cy="200" r="180" fill="url(#ringGrad)" stroke="#070707" stroke-opacity="0.18" />
            <circle cx="200" cy="200" r="150" fill="none" stroke="#070707" stroke-opacity="0.12" />
            <circle cx="200" cy="200" r="60" fill="none" stroke="#070707" stroke-opacity="0.15" />
            {Array.from({ length: 12 }).map((_, i) => {
              const angle = (i / 12) * 360;
              const rad = (angle * Math.PI) / 180;
              const x1 = 200 + Math.sin(rad) * 160;
              const y1 = 200 - Math.cos(rad) * 160;
              const x2 = 200 + Math.sin(rad) * 150;
              const y2 = 200 - Math.cos(rad) * 150;
              const tx = 200 + Math.sin(rad) * 132;
              const ty = 200 - Math.cos(rad) * 132;
              return (
                <>
                  <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#070707" stroke-opacity="0.6" stroke-width="1" />
                  <text x={tx} y={ty + 4} text-anchor="middle" fill="#070707" fill-opacity="0.5" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.15em;">
                    {String(i === 0 ? 12 : i).padStart(2, '0')}
                  </text>
                </>
              );
            })}
          </svg>

          <!-- Center rotating cup -->
          <div id="dialCup" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[38%] aspect-[3/4] transition-transform duration-300"
               data-tilt="14">
            <div class="relative w-full h-full overflow-hidden rounded-sm">
              <img src={cupImage} alt="Fabuela signature iced drink" loading="lazy" class="w-full h-full object-cover" />
            </div>
            <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 mono text-[10px] tracking-[0.28em] uppercase text-ink/55 whitespace-nowrap">
              // Signature Iced
            </div>
          </div>

          <!-- Amber pulse marker -->
          <div class="absolute top-[6%] right-[24%] flex items-center gap-2">
            <span class="dot-pulse"></span>
            <span class="mono text-[10px] tracking-[0.25em] uppercase text-ink/45">Erbil</span>
          </div>
          <div class="absolute bottom-[16%] left-[8%] flex items-center gap-2">
            <span class="dot-pulse" style="background:#B07A45"></span>
            <span class="mono text-[10px] tracking-[0.25em] uppercase text-ink/45">Baghdad</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const cup = document.getElementById('dialCup');
    const wrap = document.getElementById('dialWrap');
    if (!cup || !wrap) return;
    let raf;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const r = wrap.getBoundingClientRect();
        const center = window.innerHeight / 2;
        const t = (center - r.top - r.height / 2) / r.height;
        const rot = Math.max(-38, Math.min(38, t * 38));
        cup.style.setProperty('--rot', rot + 'deg');
        if (!cup.matches(':hover')) cup.style.transform = `translate(-50%, -50%) rotate(${rot}deg)`;
        raf = null;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>