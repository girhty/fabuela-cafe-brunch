---
import { BRAND, LOCATIONS } from '../data/site.ts';
---

<section
  id="locations"
  data-theme="light"
  class="relative bg-bone text-[#070707] py-24 sm:py-32 lg:py-40 overflow-hidden"
>
  <div class="swirl" aria-hidden="true" style="transform: scaleX(-1);"></div>

  <div class="relative z-10 px-6 sm:px-10 lg:px-12 max-w-[1440px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- LEFT: info -->
      <div class="lg:col-span-6 order-2 lg:order-1">
        <div class="reveal-mask">
          <div class="flex items-center gap-3 mb-6">
            <span class="h-[7px] w-[7px] rounded-full bg-crema animate-pulse-dot"></span>
            <div class="font-mono text-[10.5px] tracking-[0.3em] text-[#070707]/55">
              OUR LOCATIONS
            </div>
          </div>
        </div>

        <h2 class="font-display font-black leading-[0.9] tracking-[-0.045em] text-[#070707] text-[clamp(2rem,6.4vw,4.6rem)]">
          <span class="reveal-mask block"><span>THREE CITIES.</span></span>
          <span class="reveal-mask block"><span>ONE FABUELA.</span></span>
        </h2>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-8">
          {LOCATIONS.map((loc, i) => (
            <div class="fade-up" style={`transition-delay:${i * 90}ms`}>
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-[10px] tracking-[0.28em] text-crema2">
                  0{i + 1}
                </span>
                <div class="font-display font-black text-xl tracking-[-0.02em] text-[#070707]">
                  {loc.city}
                </div>
              </div>
              <div class="mt-3 pl-[2.35rem] font-mono text-[11.5px] tracking-[0.1em] leading-relaxed text-[#070707]/65">
                {loc.lines.map((line) => <div>{line}</div>)}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-14 flex flex-wrap items-end gap-x-12 gap-y-6 border-t border-[#070707]/15 pt-8">
          <div>
            <div class="font-mono text-[9.5px] tracking-[0.3em] text-[#070707]/45">OPEN DAILY</div>
            <div class="font-mono text-[12px] tracking-[0.22em] text-[#070707] mt-1.5">
              07:00 – 23:00
            </div>
          </div>
          <div>
            <div class="font-mono text-[9.5px] tracking-[0.3em] text-[#070707]/45">CALL</div>
            <a
              href={BRAND.phoneHref}
              class="font-mono text-[12px] tracking-[0.22em] text-[#070707] mt-1.5 ul-link block"
            >
              {BRAND.phone}
            </a>
          </div>
          <div>
            <div class="font-mono text-[9.5px] tracking-[0.3em] text-[#070707]/45">EMAIL</div>
            <a
              href={`mailto:${BRAND.email}`}
              class="font-mono text-[12px] tracking-[0.22em] text-[#070707] mt-1.5 ul-link block"
            >
              {BRAND.email}
            </a>
          </div>
        </div>
      </div>

      <!-- RIGHT: clock dial centerpiece -->
      <div class="lg:col-span-6 order-1 lg:order-2 flex items-center justify-center">
        <div
          class="relative w-full max-w-[520px] aspect-square"
          data-tilt="7"
        >
          <!-- Dial SVG -->
          <svg viewBox="0 0 400 400" class="absolute inset-0 w-full h-full">
            <defs>
              <radialGradient id="dial-glow" cx="50%" cy="50%">
                <stop offset="0%" stop-color="rgba(213,140,61,0.18)" />
                <stop offset="100%" stop-color="rgba(213,140,61,0)" />
              </radialGradient>
            </defs>
            <circle cx="200" cy="200" r="190" fill="url(#dial-glow)" />
            <circle cx="200" cy="200" r="168" fill="none" stroke="#070707" stroke-opacity="0.85" stroke-width="1.2" />
            <circle cx="200" cy="200" r="148" fill="none" stroke="#070707" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="2 4" />
            <!-- Tick marks -->
            {Array.from({ length: 60 }).map((_, i) => {
              const major = i % 5 === 0;
              const angle = (i / 60) * 360;
              return (
                <line
                  x1="200"
                  y1="32"
                  x2="200"
                  y2={major ? 46 : 40}
                  stroke="#070707"
                  stroke-opacity={major ? 0.85 : 0.3}
                  stroke-width={major ? 1.4 : 1}
                  transform={`rotate(${angle} 200 200)`}
                />
              );
            })}
            <!-- Hours numerals -->
            {[
              { n: '07', x: 200, y: 62 },
              { n: '09', x: 322, y: 118 },
              { n: '12', x: 335, y: 205 },
              { n: '15', x: 318, y: 288 },
              { n: '18', x: 200, y: 348 },
              { n: '21', x: 82, y: 288 },
              { n: '23', x: 65, y: 205 },
            ].map((h) => (
              <text
                x={h.x}
                y={h.y}
                text-anchor="middle"
                font-family="JetBrains Mono, monospace"
                font-size="10"
                letter-spacing="2"
                fill="#070707"
                fill-opacity="0.65"
              >
                {h.n}
              </text>
            ))}
          </svg>

          <!-- Center cup -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="relative animate-drift-slow">
              <img
                src="https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/814768822_17945634477319753_8327829479757198532_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=qgvjn_5DZq8Q7kNvwHcz16z&_nc_oc=Ado1LmBZvGsaAqCpQaKDhyVa5gUGAUfk_ZAUtNBGAmZGYebttjm80dJ61eUYMjbEp-M&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=894QDhTe_WSwFhcRmKJ6Dw&_nc_ss=79a8c&oh=00_AQIJrkrTDWjG2WxtwlEeC8Jdmfs0stzv-0xlLYofce2zUA&oe=6ABF28C9"
                alt="Fabuela iced drink"
                referrerpolicy="no-referrer"
                loading="lazy"
                class="w-40 sm:w-52 lg:w-56 h-auto rounded-full object-cover aspect-square border-4 border-bone shadow-xl"
              />
            </div>
          </div>

          <!-- Corner labels -->
          <div class="absolute top-0 left-0 font-mono text-[9.5px] tracking-[0.3em] text-[#070707]/45">
            // ERBIL · LOCAL TIME
          </div>
          <div class="absolute bottom-0 right-0 font-mono text-[9.5px] tracking-[0.3em] text-[#070707]/45 text-right">
            DIAL #01 · GMT+3
          </div>
        </div>
      </div>
    </div>
  </div>
</section>