---
import { BRAND, LOCATIONS } from '../data/site.ts';
---

<footer
  data-theme="dark"
  class="relative bg-roast pt-24 sm:pt-28 pb-8 overflow-hidden grain"
>
  <div class="swirl" aria-hidden="true" style="opacity:.04"></div>

  <div class="relative z-10 px-6 sm:px-10 lg:px-12 max-w-[1440px] mx-auto">
    <!-- Top row -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-14 border-b border-white/10">
      <div class="lg:col-span-5">
        <div class="reveal-mask">
          <div class="flex items-center gap-4">
            <img
              src={BRAND.profilePic}
              alt={BRAND.name}
              referrerpolicy="no-referrer"
              loading="lazy"
              class="h-12 w-12 rounded-full object-cover border border-white/15"
            />
            <div>
              <div class="font-display font-black text-2xl tracking-[-0.03em] text-white leading-none">
                FABUELA
              </div>
              <div class="font-mono text-[10px] tracking-[0.3em] text-white/45 mt-1.5">
                CAFE &amp; BRUNCH · {BRAND.nameKu}
              </div>
            </div>
          </div>
        </div>

        <p class="reveal-mask mt-6 max-w-sm">
          <span class="block font-sans text-[13.5px] leading-relaxed text-white/55">
            {BRAND.tagline}
          </span>
        </p>
      </div>

      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8 lg:pl-10">
        <div>
          <div class="font-mono text-[10px] tracking-[0.3em] text-white/45">EXPLORE</div>
          <ul class="mt-5 space-y-3">
            {[
              { l: 'BRUNCH MENU', h: '#menu' },
              { l: 'INSTAGRAM', h: '#instagram' },
              { l: 'REVIEWS', h: '#reviews' },
            ].map((it) => (
              <li>
                <a href={it.h} class="font-mono text-[11.5px] tracking-[0.22em] text-white/85 ul-link">
                  {it.l}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="font-mono text-[10px] tracking-[0.3em] text-white/45">VISIT</div>
          <ul class="mt-5 space-y-3">
            {[
              { l: 'OUR LOCATIONS', h: '#locations' },
              { l: 'OUR STORY', h: '#philosophy' },
              { l: 'ORDER ONLINE', h: '#order' },
            ].map((it) => (
              <li>
                <a href={it.h} class="font-mono text-[11.5px] tracking-[0.22em] text-white/85 ul-link">
                  {it.l}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="font-mono text-[10px] tracking-[0.3em] text-white/45">CONTACT</div>
          <ul class="mt-5 space-y-3">
            <li>
              <a href={BRAND.phoneHref} class="font-mono text-[11.5px] tracking-[0.22em] text-white/85 ul-link">
                {BRAND.phone}
              </a>
            </li>
            <li>
              <a href={`mailto:${BRAND.email}`} class="font-mono text-[11.5px] tracking-[0.22em] text-white/85 ul-link">
                {BRAND.email}
              </a>
            </li>
            <li>
              <a
                href={BRAND.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-[11.5px] tracking-[0.22em] text-white/85 ul-link"
              >
                {BRAND.instagramHandle}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Locations row -->
    <div class="py-10 border-b border-white/10">
      <div class="reveal-mask mb-8">
        <div class="flex items-center gap-3">
          <span class="h-[6px] w-[6px] rounded-full bg-crema animate-pulse-dot"></span>
          <div class="font-mono text-[10px] tracking-[0.3em] text-white/55">OUR LOCATIONS</div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-8 lg:gap-y-0 lg:divide-x divide-white/10">
        {LOCATIONS.map((loc, i) => (
          <div class="lg:px-10 first:lg:pl-0">
            <div class="font-mono text-[9.5px] tracking-[0.3em] text-crema/70">
              0{i + 1}
            </div>
            <div class="font-display font-black text-lg tracking-[-0.01em] text-white mt-2">
              {loc.city}
            </div>
            <div class="font-mono text-[11px] tracking-[0.16em] leading-relaxed text-white/55 mt-2">
              {loc.lines.map((line) => <div>{line}</div>)}
            </div>
          </div>
        ))}
        <div class="lg:px-10">
          <div class="font-mono text-[9.5px] tracking-[0.3em] text-crema/70">HOURS</div>
          <div class="font-display font-black text-lg tracking-[-0.01em] text-white mt-2">
            OPEN DAILY
          </div>
          <div class="font-mono text-[11px] tracking-[0.16em] leading-relaxed text-white/55 mt-2">
            <div>07:00 – 23:00</div>
            <div>GMT+3</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Legal bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="font-mono text-[10px] tracking-[0.28em] text-white/40">
        © {new Date().getFullYear()} FABUELA CAFE &amp; BRUNCH.
      </div>
      <div class="flex items-center gap-6">
        <a
          href={BRAND.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[10px] tracking-[0.28em] text-white/40 hover:text-white/80 transition-colors"
        >
          INSTAGRAM
        </a>
        <span class="text-white/20">·</span>
        <a
          href="https://tiktok.com"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[10px] tracking-[0.28em] text-white/40 hover:text-white/80 transition-colors"
        >
          TIKTOK
        </a>
      </div>
      <div class="flex items-center gap-6">
        <a href="#privacy" class="font-mono text-[10px] tracking-[0.28em] text-white/40 hover:text-white/80 transition-colors">
          PRIVACY POLICY
        </a>
        <span class="text-white/20">/</span>
        <a href="#terms" class="font-mono text-[10px] tracking-[0.28em] text-white/40 hover:text-white/80 transition-colors">
          TERMS OF USE
        </a>
      </div>
    </div>
  </div>
</footer>