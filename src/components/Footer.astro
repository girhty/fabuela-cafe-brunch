---
const columns = [
  { heading: 'Shop', links: ['Coffee', 'Subscriptions', 'Merchandise'] },
  { heading: 'Menu', links: ['Coffee', 'Non-Coffee', 'Food'] },
  { heading: 'About Us', links: ['Our Story', 'Sourcing', 'Careers'] },
];
const branches = ['Erbil · Empire Pearl P7', 'Sulaymaniyah · Grand Boulevard', 'Baghdad · Mansur — Al Dawoodi'];
---
<footer data-surface="dark" class="relative bg-ink overflow-hidden noise">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[80vw] h-[50vw] rounded-full blur-[180px] opacity-[0.15]" style="background: radial-gradient(circle, #6E3E22 0%, transparent 65%);"></div>
  </div>

  <div class="relative max-w-[1440px] mx-auto px-6 sm:px-10 py-20 sm:py-24">
    <!-- Top row -->
    <div class="grid lg:grid-cols-12 gap-10 pb-14 border-b border-white/10">
      <div class="lg:col-span-5">
        <div class="display text-4xl sm:text-5xl text-white tracking-tight">
          <span class="line-mask"><span>FABUELA.</span></span>
        </div>
        <div class="mono text-[10px] tracking-[0.3em] text-white/40 uppercase mt-3">
          Coffee for right now. Made for your day.
        </div>
      </div>

      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-4 gap-6">
        {columns.map((c) => (
          <div>
            <div class="mono text-[10px] tracking-[0.3em] text-white/35 uppercase mb-4">{c.heading}</div>
            <ul class="flex flex-col gap-2.5">
              {c.links.map((l) => (
                <li><a href="#" class="text-sm text-white/70 hover:text-white ulink">{l}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div>
          <div class="mono text-[10px] tracking-[0.3em] text-white/35 uppercase mb-4">Contact</div>
          <ul class="flex flex-col gap-2.5">
            <li><a href="mailto:hello@fabuela.iq" class="text-sm text-white/70 hover:text-white ulink">hello@fabuela.iq</a></li>
            <li><a href="tel:+9647516244424" class="text-sm text-white/70 hover:text-white ulink">+964 751 624 4424</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Locations row -->
    <div class="py-10 border-b border-white/10">
      <div class="flex items-center gap-3 mono text-[10px] tracking-[0.3em] text-white/50 uppercase mb-5">
        <span class="dot-pulse"></span>
        <span>Our Locations</span>
      </div>
      <div class="flex flex-wrap gap-y-4 mono text-[11px] tracking-[0.2em] uppercase text-white/70">
        {branches.map((b, i) => (
          <>
            <span class="pr-6">{b}</span>
            {i < branches.length - 1 && <span class="hidden sm:inline-block w-px h-4 bg-white/15 mr-6" aria-hidden="true"></span>}
            {i === branches.length - 1 && <span class="ml-auto text-white/50">Open Daily · 07:00 — 21:00</span>}
          </>
        ))}
      </div>
    </div>

    <!-- Legal row -->
    <div class="pt-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mono text-[10px] tracking-[0.25em] uppercase text-white/40">
      <div>© 2026 Fabuela Cafe &amp; Brunch.</div>
      <div class="flex gap-6">
        <a href="https://instagram.com/fabuela.iq" target="_blank" rel="noopener" class="ulink hover:text-white">Instagram</a>
        <a href="https://tiktok.com" target="_blank" rel="noopener" class="ulink hover:text-white">TikTok</a>
      </div>
      <div class="flex gap-6">
        <a href="#privacy" class="ulink hover:text-white">Privacy Policy</a>
        <a href="#terms" class="ulink hover:text-white">Terms</a>
      </div>
    </div>
  </div>
</footer>