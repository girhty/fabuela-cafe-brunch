---
import { brand, contact, locations, footerCols } from '../data/site.js';
---
<footer data-theme="dark" data-reveal class="relative overflow-hidden bg-canvas pb-8 pt-24 text-white" aria-labelledby="footer-title">
  <svg class="pointer-events-none absolute -right-40 top-0 h-[600px] w-[1100px] text-white/[.03]" viewBox="0 0 1100 600" fill="none" aria-hidden="true">
    <path d="M40 500 C 260 180, 460 620, 640 320 S 940 40, 1060 200" stroke="currentColor" stroke-width="110" stroke-linecap="round" />
  </svg>

  <div class="relative mx-auto max-w-[1440px] px-5 sm:px-10">
    <div class="grid grid-cols-1 gap-14 border-b border-white/10 pb-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="#top" class="flex items-center gap-4" aria-label="Back to top">
          <img src={brand.logo} alt="Fabuela logo" referrerpolicy="no-referrer" loading="lazy" width="64" height="64" class="h-14 w-14 rounded-full object-cover ring-1 ring-white/25" />
          <span id="footer-title" class="mask display text-5xl sm:text-6xl"><span>Fabuela</span></span>
        </a>
        <p class="mask mt-6 font-mono text-[11px] tracking-wider text-white/55"><span style="--d:120ms">{brand.tagline}</span></p>
        <p class="mask mt-2 font-arabic text-lg text-white/40" lang="ckb" dir="rtl"><span style="--d:200ms">فابوێلا کافێ · یەکەم کافێی بڕانچ لە عێراق</span></p>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-10 sm:grid-cols-4 lg:col-span-7">
        {footerCols.map((col, ci) => (
          <div>
            <p class="mask font-mono text-[11px] text-white/35"><span style={`--d:${ci * 80}ms`}>{col.heading}</span></p>
            <ul class="mt-4 space-y-2 font-mono text-[12px] uppercase">
              {col.links.map((l, li) => (
                <li class="mask">
                  <span style={`--d:${ci * 80 + (li + 1) * 60}ms`}>
                    <a href={l.href} class="link-u" {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="border-b border-white/10 py-10">
      <p class="mask font-mono text-[11px] tracking-wider"><span class="flex items-center gap-3"><span class="pulse" aria-hidden="true"></span> OUR LOCATIONS</span></p>
      <div class="mt-6 flex flex-col gap-6 font-mono text-[12px] uppercase leading-relaxed lg:flex-row lg:items-stretch lg:gap-0">
        {locations.map((l, i) => (
          <div class={`lg:px-8 ${i === 0 ? 'lg:pl-0' : ''} lg:border-r lg:border-white/10`}>
            <p class="mask"><span style={`--d:${i * 80}ms`}>{l.city} — {l.status}</span></p>
            <p class="mask text-white/45"><span style={`--d:${i * 80 + 60}ms`}>{l.lines[0]}</span></p>
          </div>
        ))}
        <div class="lg:pl-8">
          <p class="mask"><span>Open now</span></p>
          <p class="mask text-white/45"><span style="--d:60ms">Brunch all day</span></p>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4 pt-8 font-mono text-[10px] uppercase tracking-wider text-white/45 md:flex-row md:items-center md:justify-between">
      <p class="mask"><span>© 2026 Fabuela Cafe &amp; Brunch.</span></p>
      <p class="mask"><span><a href={brand.igUrl} target="_blank" rel="noopener" class="link-u">Instagram</a> &amp; <a href={contact.tel} class="link-u">{contact.phone}</a></span></p>
      <p class="mask"><span><a href="#top" class="link-u">Privacy policy</a> / <a href="#top" class="link-u">Terms of use</a></span></p>
    </div>
  </div>
</footer>