---
import { BRAND, REVIEWS } from '../data/site.ts';
const counts = [
  { label: 'GOOGLE', value: BRAND.rating.toFixed(1) },
  { label: 'REVIEWS', value: BRAND.reviewCount.toString() },
  { label: 'CITIES', value: '03' },
  { label: 'SINCE', value: '2019' },
];
---

<section
  id="reviews"
  data-theme="dark"
  class="relative bg-roast py-24 sm:py-32 lg:py-40 overflow-hidden grain"
>
  <div class="relative z-10 px-6 sm:px-10 lg:px-12 max-w-[1440px] mx-auto">
    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-7">
        <div class="reveal-mask">
          <div class="font-mono text-[10.5px] tracking-[0.3em] text-white/55 mb-6">
            // LOVED BY 887 GUESTS
          </div>
        </div>
        <h2 class="font-display font-black leading-[0.9] tracking-[-0.045em] text-white text-[clamp(2rem,6.4vw,4.8rem)]">
          <span class="reveal-mask block"><span>WHAT THEY SAY</span></span>
          <span class="reveal-mask block"><span>ABOUT US.</span></span>
        </h2>
      </div>

      <div class="lg:col-span-5 lg:pl-10">
        <div class="reveal-mask inline-flex items-center gap-4 border border-white/15 rounded-full px-5 py-3 bg-white/[0.03]">
          <span class="text-crema text-xl leading-none">★</span>
          <span class="font-display font-black text-2xl tracking-[-0.02em] text-white">
            {BRAND.rating.toFixed(1)}
          </span>
          <span class="h-5 w-px bg-white/15"></span>
          <span class="font-mono text-[10px] tracking-[0.24em] text-white/60">
            ON GOOGLE REVIEWS
          </span>
        </div>
      </div>
    </div>

    <!-- Cards -->
    <div class="mt-14 sm:mt-20 grid grid-cols-1 md:grid-cols-3 gap-5">
      {REVIEWS.map((r, i) => (
        <article
          class="fade-up relative border border-white/12 rounded-[2px] p-7 sm:p-8 bg-white/[0.02] flex flex-col"
          style={`transition-delay:${i * 100}ms`}
          data-tilt="4"
        >
          <div class="flex items-center gap-1 text-crema text-[15px]">
            {Array.from({ length: 5 }).map((_, k) => (
              <span class={k < r.rating ? '' : 'text-white/20'}>★</span>
            ))}
          </div>

          <p class="mt-6 font-sans text-[14.5px] leading-relaxed text-white/75 flex-1">
            “{r.text}”
          </p>

          <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between">
            <div>
              <div class="font-display font-black text-base tracking-[-0.01em] text-white">
                {r.author}
              </div>
              <div class="font-mono text-[9.5px] tracking-[0.28em] text-white/40 mt-1">
                {r.role}
              </div>
            </div>
            <div class="font-mono text-[9.5px] tracking-[0.28em] text-white/40">
              {String(i + 1).padStart(2, '0')}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Counts -->
    <div class="mt-16 sm:mt-20 grid grid-cols-2 md:grid-cols-4 border-y border-white/10 divide-y md:divide-y-0 md:divide-x divide-white/10">
      {counts.map((c) => (
        <div class="px-6 py-8 flex flex-col items-center justify-center">
          <div class="font-display font-black text-4xl sm:text-5xl tracking-[-0.04em] text-white leading-none tabular-nums">
            {c.value}
          </div>
          <div class="font-mono text-[10px] tracking-[0.3em] text-white/45 mt-3">
            {c.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>