---
import { reviews, rating, contact } from '../data/site.js';
const stars = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<section
  id="reviews"
  data-theme="light"
  data-reveal
  aria-labelledby="rev-title"
  class="relative overflow-hidden bg-bone py-24 text-canvas sm:py-32"
>
  <div class="mx-auto max-w-[1440px] px-5 sm:px-10">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow fade-up text-canvas/60">Google reviews</p>
        <h2 id="rev-title" class="display mt-5 text-[12vw] sm:text-7xl lg:text-[clamp(56px,5.6vw,96px)]">
          <span class="mask"><span>Worth the</span></span>
          <span class="mask"><span style="--d:120ms">midday heat.</span></span>
        </h2>
      </div>
      <div class="fade-up flex items-end gap-6 lg:col-span-7 lg:justify-end" style="--d:200ms">
        <div class="flex items-center gap-5 border border-canvas px-6 py-5">
          <span class="display text-7xl">{rating.value}</span>
          <div class="font-mono text-[11px] uppercase">
            <p class="text-lg tracking-widest text-canvas" aria-label={`${rating.value} out of 5 stars`}>★★★★★</p>
            <p class="text-canvas/55">{rating.total} reviews on Google</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-3">
      {reviews.map((r, i) => (
        <figure data-tilt data-tilt-max="4" class="tilt fade-up flex flex-col justify-between border border-canvas bg-bone p-7" style={`--d:${i * 120}ms`}>
          <div>
            <div class="flex items-center justify-between font-mono text-[11px]">
              <span class="text-canvas/40">{String(i + 1).padStart(2, '0')}</span>
              <span class="tracking-widest" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</span>
            </div>
            <blockquote class="mt-6 text-[16px] leading-relaxed text-canvas/80">“{r.text}”</blockquote>
          </div>
          <figcaption class="mt-8 flex items-center gap-3 border-t border-canvas/15 pt-4 font-mono text-[11px] uppercase">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-canvas text-bone">{r.author_name.charAt(0)}</span>
            {r.author_name}
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Contact & map card -->
    <div class="mt-16 grid grid-cols-1 overflow-hidden border border-canvas lg:grid-cols-12">
      <div class="flex flex-col justify-between gap-10 p-7 sm:p-10 lg:col-span-5">
        <div>
          <p class="flex items-center gap-3 font-mono text-[11px] tracking-wider"><span class="pulse" aria-hidden="true"></span> OPEN NOW · VISIT US</p>
          <h3 class="display mt-5 text-4xl sm:text-5xl">Empire Pearl P7</h3>
          <address class="mt-4 font-mono text-[12px] uppercase not-italic leading-relaxed text-canvas/60">{contact.address}</address>
        </div>
        <dl class="grid grid-cols-2 gap-6 font-mono text-[12px] uppercase">
          <div><dt class="text-canvas/40">Phone</dt><dd class="mt-1"><a href={contact.tel} class="link-u">{contact.phone}</a></dd></div>
          <div><dt class="text-canvas/40">Hours</dt><dd class="mt-1">Brunch all day</dd></div>
        </dl>
        <a href={contact.mapsUrl} target="_blank" rel="noopener" class="link-cta self-start font-mono text-[12px] tracking-wider">OPEN IN GOOGLE MAPS <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="relative min-h-[340px] border-t border-canvas lg:col-span-7 lg:border-l lg:border-t-0">
        <iframe
          title="Map showing Fabuela Cafe & Brunch in Erbil"
          src={contact.embed}
          class="absolute inset-0 h-full w-full grayscale-[.85] contrast-[1.05]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>