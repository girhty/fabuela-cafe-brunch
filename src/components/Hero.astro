---
import { brand, posts, rating, contact } from '../data/site.js';
const plate = posts[1];
const cup = posts[3];
---
<section
  data-theme="dark"
  data-reveal
  aria-labelledby="hero-title"
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-canvas text-white"
>
  <div class="liquid" aria-hidden="true"><span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span></div>
  <div class="absolute inset-0 z-0 bg-[linear-gradient(90deg,rgba(10,12,8,.8)_0%,rgba(10,12,8,.45)_35%,transparent_60%)]" aria-hidden="true"></div>
  <div class="grain z-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid w-full max-w-[1440px] flex-1 grid-cols-1 items-center gap-10 px-5 pb-8 pt-28 sm:px-10 lg:grid-cols-12 lg:pb-32 lg:pt-24">
    <!-- Copy stack -->
    <div class="lg:col-span-6">
      <p class="eyebrow fade-up text-white/60">The first brunch café in Iraq</p>

      <h1 id="hero-title" class="display mt-6 text-[14vw] sm:text-[10vw] lg:text-[clamp(64px,7.6vw,124px)]">
        <span class="mask"><span style="--d:150ms">Brunch</span></span>
        <span class="mask"><span style="--d:260ms">for your</span></span>
        <span class="relative block">
          <span class="wipe absolute -top-[.35em] left-[2.6em] block -rotate-6 font-script text-[1.15em] font-normal normal-case tracking-normal text-crema drop-shadow-[0_6px_24px_rgba(0,0,0,.5)]" style="--d:900ms">morning</span>
          <span class="invisible">&nbsp;</span>
        </span>
      </h1>

      <p class="fade-up mt-2 max-w-md font-mono text-[12px] uppercase leading-relaxed tracking-wide text-white/60" style="--d:500ms">
        Fresh plates, house-made special sauces and bread worth crossing the city for — cooked to order every morning in Erbil.
      </p>

      <div class="fade-up mt-8 flex flex-wrap items-center gap-6" style="--d:650ms">
        <a href="#menu" class="link-cta font-mono text-[12px] tracking-wider">EXPLORE MENU <span class="arr" aria-hidden="true">→</span></a>
        <a href="#reviews" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 font-mono text-[11px] tracking-wider backdrop-blur-md transition hover:border-accent/60">
          <span class="text-accent" aria-hidden="true">★</span> {rating.value} ON GOOGLE · {rating.total} REVIEWS
        </a>
      </div>
    </div>

    <!-- Product showcase -->
    <div class="relative h-[420px] sm:h-[560px] lg:col-span-6 lg:h-[620px]" data-tilt-area>
      <div data-tilt data-tilt-max="7" class="tilt absolute inset-0 cursor-grab active:cursor-grabbing">
        <figure
          tabindex="0"
          class="group absolute left-[2%] top-[4%] w-[60%] outline-none"
          style="transform: translateZ(30px) rotate(-4deg)"
        >
          <div class="aspect-[4/5] overflow-hidden rounded-[28px] shadow-[0_40px_80px_-20px_rgba(0,0,0,.8)] ring-1 ring-white/10">
            <img src={plate.image} alt="Fabuela brunch plate — eggs, toast and fresh sides" referrerpolicy="no-referrer" class="h-full w-full object-cover transition-transform duration-[1.2s] group-hover:scale-105" width="640" height="800" />
          </div>
          <figcaption class="pointer-events-none absolute -right-6 bottom-8 w-56 translate-y-3 rounded-2xl border border-white/15 bg-canvas/55 p-4 opacity-0 backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(.34,1.4,.64,1)] group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 sm:-right-16">
            <p class="eyebrow text-white/50">On the plate</p>
            <div class="mt-2 flex items-baseline justify-between">
              <p class="display text-xl">Brunch Day</p>
              <p class="font-mono text-[11px] text-accent">ALL DAY</p>
            </div>
            <p class="mt-2 font-mono text-[10px] leading-relaxed text-white/55">EGGS BENEDICT • FRENCH TOAST • FRESH BREAD</p>
          </figcaption>
        </figure>

        <figure
          tabindex="0"
          class="group absolute bottom-[2%] right-[2%] w-[44%] outline-none"
          style="transform: translateZ(80px) rotate(5deg)"
        >
          <div class="aspect-[3/4] overflow-hidden rounded-[999px_999px_28px_28px] shadow-[0_40px_80px_-20px_rgba(0,0,0,.85)] ring-1 ring-white/10">
            <img src={cup.image} alt="Fabuela iced drinks — hot days, cold drinks" referrerpolicy="no-referrer" class="h-full w-full object-cover transition-transform duration-[1.2s] group-hover:scale-105" width="480" height="640" />
          </div>
          <figcaption class="pointer-events-none absolute -left-10 top-10 w-52 translate-y-3 rounded-2xl border border-white/15 bg-canvas/55 p-4 opacity-0 backdrop-blur-xl transition-all duration-500 ease-[cubic-bezier(.34,1.4,.64,1)] group-hover:translate-y-0 group-hover:opacity-100 group-focus:translate-y-0 group-focus:opacity-100 sm:-left-24">
            <p class="eyebrow text-white/50">In the cup</p>
            <div class="mt-2 flex items-baseline justify-between">
              <p class="display text-xl">Cold Drinks</p>
              <p class="font-mono text-[11px] text-accent">ICED</p>
            </div>
            <p class="mt-2 font-mono text-[10px] leading-relaxed text-white/55">GREENX JUICE • ICED LATTE • GOOD MOOD</p>
          </figcaption>
        </figure>

        <div class="absolute right-[8%] top-[6%] flex h-24 w-24 items-center justify-center rounded-full border border-white/20 font-mono text-[9px] uppercase tracking-[.2em] text-white/60 sm:h-28 sm:w-28" style="transform: translateZ(120px)" aria-hidden="true">
          <span class="text-center leading-relaxed">Est.<br/>Erbil<br/>🫰🏻</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Info bar -->
  <div class="relative z-10 mx-auto w-full max-w-[1440px] px-5 pb-6 sm:px-10 lg:absolute lg:inset-x-0 lg:bottom-10 lg:pb-0">
    <div class="grid grid-cols-1 gap-5 border-t border-white/10 pt-5 font-mono text-[11px] uppercase tracking-wider sm:grid-cols-3 sm:gap-0">
      <div class="fade-up sm:pr-6" style="--d:700ms">
        <p class="flex items-center gap-2 text-white/40"><span class="pulse" aria-hidden="true"></span> Open now</p>
        <p class="mt-1 text-white">Brunch served all day</p>
      </div>
      <div class="fade-up sm:border-l sm:border-white/15 sm:px-6" style="--d:800ms">
        <p class="text-white/40">Empire Pearl P7</p>
        <p class="mt-1 text-white">{contact.plus} · Erbil, Iraq</p>
      </div>
      <div class="fade-up sm:border-l sm:border-white/15 sm:pl-6" style="--d:900ms">
        <p class="text-white/40">Follow · {Math.round(brand.followers / 1000)}K</p>
        <p class="mt-1 flex gap-4">
          <a href={brand.igUrl} target="_blank" rel="noopener" class="link-u">Instagram</a>
          <a href={contact.tel} class="link-u">Call us</a>
        </p>
      </div>
    </div>
  </div>
</section>