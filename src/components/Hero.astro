---
import { BRAND } from '../data/site.ts';

const heroImage =
  'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/819021610_17946220923319753_4683366529875807962_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=auJkTd8GQEwQ7kNvwGBaCrT&_nc_oc=Adrb0TXAfBIDP4MZmUDwebBI1D6QL127YKmJGpfoR2fAlF2vzJnbWLsyEOwRVE-41No&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=894QDhTe_WSwFhcRmKJ6Dw&_nc_ss=79a8c&oh=00_AQLiNc81uh1iBL-y8qm0EfMPrAmEFf-U74hlYPg6WGoenQ&oe=6ABF4A46';
---

<section
  id="top"
  data-theme="dark"
  class="relative grain overflow-hidden min-h-[100svh] flex flex-col"
>
  <!-- Ambient liquid -->
  <div class="ambient-liquid" aria-hidden="true"></div>

  <!-- Left readability scrim -->
  <div
    class="pointer-events-none absolute inset-0 z-[1]"
    style="background: linear-gradient(90deg, rgba(7,7,7,0.85) 0%, rgba(7,7,7,0.35) 45%, transparent 62%);"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 px-6 sm:px-10 lg:px-12 pt-32 sm:pt-36 lg:pt-40 pb-32 sm:pb-28 flex-1">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      <!-- LEFT COLUMN -->
      <div class="lg:col-span-6 xl:col-span-7">
        <div class="reveal-mask mb-6">
          <div class="font-mono text-[10px] sm:text-[11px] tracking-[0.3em] text-white/60">
            // THE FIRST BRUNCH CAFÉ IN IRAQ
          </div>
        </div>

        <h1 class="font-display font-black leading-[0.88] tracking-[-0.045em] text-white text-[clamp(2.6rem,10vw,7rem)]">
          <span class="reveal-mask block"><span>BRUNCH FOR</span></span>
          <span class="relative inline-block">
            <span class="reveal-mask block pr-2"><span>YOUR</span></span>
            <span
              class="script-wipe font-script font-bold text-crema absolute left-[38%] sm:left-[34%] lg:left-[30%] -bottom-4 sm:-bottom-6 lg:-bottom-8 text-[clamp(2.4rem,8vw,6.5rem)] leading-none tracking-normal"
              aria-hidden="true"
            >
              moment
            </span>
          </span>
        </h1>

        <p class="reveal-mask mt-16 sm:mt-20 max-w-md">
          <span class="block font-sans text-[13px] sm:text-sm leading-relaxed text-white/60 tracking-[0.02em]">
            CAREFULLY SOURCED BEANS AND THOUGHTFULLY PLATED BRUNCH — SERVED DAILY ACROSS ERBIL, SULAYMANIYAH, AND BAGHDAD.
          </span>
        </p>

        <div class="reveal-mask mt-10">
          <a
            href="#menu"
            class="inline-flex items-center gap-3 font-mono text-[12px] tracking-[0.28em] text-white ul-link group"
          >
            <span>EXPLORE MENU</span>
            <span class="inline-block transition-transform duration-500 group-hover:translate-x-1.5">→</span>
          </a>
        </div>
      </div>

      <!-- RIGHT COLUMN — Product visual -->
      <div class="lg:col-span-6 xl:col-span-5 relative">
        <div
          class="relative mx-auto max-w-[520px] aspect-[4/5] rounded-[2px] overflow-hidden border border-white/10 cursor-grab active:cursor-grabbing"
          data-tilt="9"
          style="background: linear-gradient(180deg, rgba(23,23,21,0.6) 0%, rgba(7,7,7,0.6) 100%);"
        >
          <img
            src={heroImage}
            alt="Fabuela signature brunch plate"
            referrerpolicy="no-referrer"
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/10"></div>

          <!-- rating badge -->
          <div class="absolute top-4 left-4 flex items-center gap-2 bg-black/55 backdrop-blur-md border border-white/15 px-3 py-2 rounded-full">
            <span class="text-crema text-[13px] leading-none">★</span>
            <span class="font-mono text-[10.5px] tracking-[0.2em] text-white">{BRAND.rating}</span>
            <span class="h-3 w-px bg-white/20"></span>
            <span class="font-mono text-[10px] tracking-[0.18em] text-white/60">{BRAND.reviewCount} REVIEWS</span>
          </div>

          <!-- Bottom spec -->
          <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-4">
            <div>
              <div class="font-mono text-[10px] tracking-[0.28em] text-white/55">// SIGNATURE PLATE</div>
              <div class="font-display font-black text-2xl sm:text-3xl tracking-[-0.02em] text-white mt-1">
                EGGS BENEDICT
              </div>
            </div>
            <div class="font-mono text-[11px] tracking-[0.2em] text-crema whitespace-nowrap">
              IQD 12,500
            </div>
          </div>
        </div>

        <!-- Floating glass spec card -->
        <div class="hidden md:block absolute -left-4 lg:-left-8 top-1/2 -translate-y-1/2 z-20 pointer-events-none">
          <div class="bg-white/[0.06] backdrop-blur-xl border border-white/15 rounded-[2px] p-4 w-[220px] shadow-2xl">
            <div class="font-mono text-[9.5px] tracking-[0.3em] text-crema/80">// IN THE PLATE</div>
            <div class="font-display font-black text-xl tracking-[-0.02em] text-white mt-2">
              FABUELA SIGNATURE
            </div>
            <div class="h-px bg-white/15 my-3"></div>
            <div class="font-mono text-[9.5px] tracking-[0.22em] text-white/60 leading-relaxed">
              HOUSE MADE · DAILY · FRESH
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom info bar -->
  <div class="relative z-10 border-t border-white/10">
    <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
      <div class="px-6 sm:px-10 lg:px-12 py-5 flex items-center gap-3">
        <span class="h-[6px] w-[6px] rounded-full bg-crema animate-pulse-dot shrink-0"></span>
        <div>
          <div class="font-mono text-[9.5px] tracking-[0.3em] text-white/40">OPEN DAILY</div>
          <div class="font-mono text-[11px] tracking-[0.22em] text-white/85 mt-0.5">07:00 – 23:00</div>
        </div>
      </div>
      <div class="px-6 sm:px-10 lg:px-12 py-5">
        <div class="font-mono text-[9.5px] tracking-[0.3em] text-white/40">LOCATED IN ERBIL</div>
        <div class="font-mono text-[11px] tracking-[0.22em] text-white/85 mt-0.5">
          EMPIRE PEARL · P7
        </div>
      </div>
      <div class="px-6 sm:px-10 lg:px-12 py-5 flex items-center justify-between">
        <a
          href={BRAND.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[11px] tracking-[0.22em] text-white/85 ul-link"
        >
          INSTAGRAM
        </a>
        <a
          href={BRAND.phoneHref}
          class="font-mono text-[11px] tracking-[0.22em] text-white/85 ul-link"
        >
          CALL US →
        </a>
      </div>
    </div>
  </div>
</section>