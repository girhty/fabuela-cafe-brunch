---
const heroImage = 'https://lh3.googleusercontent.com/grass-cs/AABkmLfGfYHr6ZDWXMy7lVq0q1lJuZaxEIm2-pX6JjQekl6O9CaaZyFbH1gUddhanW1QFKBdERPVsm3j1DxpI3Hbbgi0wIG0xtkzAgU4Ci7ZsWFS6-7NAkdUdcf6Mzq3f8GML84DKJB-reWG5MY=w800-h1000-k-no';
const secondary = 'https://lh3.googleusercontent.com/grass-cs/ACvplmMiVGuyRzM99jjTFMMCIvKBRApl_AezNT49x0cHUIYZaVF-iikTfdL8prOLj-7VtIhJjk8m2OqdGTxJSochYFB4shopLSeMG5F-uRfsiyds4A24dzZeIynVQdrp-0SBsDTOaoZvV8DFZAoX=w600-h800-k-no';
---
<section id="top" data-surface="dark" class="relative min-h-screen bg-ink overflow-hidden noise">
  <!-- Ambient gradient -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-40 -left-40 w-[60vw] h-[60vw] rounded-full blur-[160px] opacity-[0.35]" style="background: radial-gradient(circle, #6E3E22 0%, transparent 65%);"></div>
    <div class="absolute -bottom-80 right-0 w-[70vw] h-[70vw] rounded-full blur-[180px] opacity-[0.28]" style="background: radial-gradient(circle, #C69B6E 0%, transparent 60%);"></div>
  </div>

  <div class="relative z-10 max-w-[1440px] mx-auto px-6 sm:px-10 pt-32 sm:pt-40 pb-44 sm:pb-52 min-h-screen flex flex-col justify-between">
    <div class="grid lg:grid-cols-12 gap-10 items-center flex-1">
      <!-- Left copy -->
      <div class="lg:col-span-6 xl:col-span-5 flex flex-col gap-8">
        <div class="mono text-[11px] tracking-[0.3em] text-white/55 uppercase">
          // The first brunch cafe in Iraq
        </div>

        <h1 class="display text-[15vw] sm:text-[11vw] lg:text-[6.2rem] xl:text-[7rem] text-white leading-[0.9]">
          <span class="line-mask"><span>COFFEE</span></span>
          <span class="line-mask"><span>FOR</span></span>
          <span class="relative inline-block">
            <span class="line-mask"><span>YOUR</span></span>
            <span class="script absolute -right-[3.2em] sm:-right-[2.6em] bottom-[0.05em] text-[.42em] text-amber rotate-[-6deg]">
              <span class="wipe-mask"><span>brunch&nbsp;moment</span></span>
            </span>
          </span>
        </h1>

        <p class="max-w-md text-[13px] sm:text-sm leading-[1.8] text-white/55 uppercase tracking-[0.06em]">
          Erbil's original brunch house. Specialty beans, slow hours, and thoughtful plates — served without ceremony.
        </p>

        <div class="flex items-center gap-8 mt-2">
          <a href="#menu" class="group flex items-center gap-3 mono text-[11px] tracking-[0.3em] uppercase text-white/90 hover:text-white">
            <span>Explore Menu</span>
            <span class="block transition-transform duration-500 group-hover:translate-x-1.5">→</span>
          </a>
          <div class="flex items-center gap-2 mono text-[11px] tracking-[0.22em] uppercase text-white/45">
            <span class="dot-pulse" aria-hidden="true"></span>
            <span>Open Now</span>
          </div>
        </div>

        <div class="flex items-center gap-4 mt-6 pt-6 border-t border-white/10">
          <div class="flex items-center gap-2.5">
            <span class="mono text-[11px] text-amber">★ 4.8</span>
            <span class="mono text-[10px] text-white/40 tracking-[0.2em] uppercase">887 Google Reviews</span>
          </div>
        </div>
      </div>

      <!-- Right visual -->
      <div class="lg:col-span-6 xl:col-span-7 relative">
        <div class="relative aspect-[5/6] sm:aspect-[4/5] max-w-[560px] ml-auto"
             data-tilt="8">
          <div class="absolute -top-6 -left-6 mono text-[10px] tracking-[0.3em] text-white/35 uppercase">// Fabuela signature</div>
          <div class="relative w-full h-full overflow-hidden rounded-[2px] border border-white/10 bg-surface">
            <img src={heroImage} alt="Fabuela specialty coffee with latte art" loading="eager" class="w-full h-full object-cover scale-[1.02] hover:scale-105 transition-transform duration-[1400ms] ease-out" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent"></div>
          </div>

          <!-- Floating spec card -->
          <div class="absolute -bottom-4 -left-4 sm:-left-8 bg-ink/70 backdrop-blur-md border border-white/15 p-4 w-56">
            <div class="mono text-[10px] tracking-[0.3em] text-white/45 uppercase">// In the cup</div>
            <div class="flex justify-between items-baseline mt-2">
              <span class="display text-lg text-white tracking-tight">HOUSE LATTE</span>
              <span class="mono text-xs text-amber">$4.20</span>
            </div>
            <div class="mono text-[10px] tracking-[0.22em] text-white/40 mt-2">DAILY · OAT · TO GO</div>
          </div>

          <!-- Small secondary thumb -->
          <div class="hidden sm:block absolute -top-10 -right-8 w-32 h-40 overflow-hidden border border-white/10">
            <img src={secondary} alt="Fabuela interior" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom info bar -->
    <div class="absolute inset-x-6 sm:inset-x-10 bottom-6 sm:bottom-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 sm:gap-0 sm:divide-x sm:divide-white/10 mono text-[10px] tracking-[0.22em] uppercase">
        <div class="sm:pr-8">
          <div class="text-white/35">Hours</div>
          <div class="text-white mt-1">07:00 — 21:00 Daily</div>
        </div>
        <div class="sm:px-8">
          <div class="text-white/35">Erbil · HQ</div>
          <div class="text-white mt-1">Empire Pearl P7, Erbil</div>
        </div>
        <div class="hidden sm:block sm:pl-8 text-right">
          <div class="text-white/35">Follow</div>
          <div class="text-white mt-1 flex gap-4 justify-end">
            <a href="https://instagram.com/fabuela.iq" class="ulink" target="_blank" rel="noopener">Instagram</a>
            <a href="https://tiktok.com" class="ulink" target="_blank" rel="noopener">TikTok</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>